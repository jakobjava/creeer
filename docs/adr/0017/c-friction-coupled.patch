+/// ADR-0017's A/B: each tick of a reference run (friction lagged) stepped once more from its
+/// own state with friction lagged and with it followed, the same inputs for both.
+#[test]
+#[ignore = "profile"]
+fn ab_lag() {
+    use creeer_physics::world::World;
+    let scene = match std::env::var("AB_SCENE").as_deref() {
+        Ok("stacks") => PhysicsScene::Stacks,
+        Ok("crash") => PhysicsScene::Crash,
+        _ => PhysicsScene::Rocks,
+    };
+    let ticks: usize = std::env::var("AB_TICKS").ok().and_then(|s| s.parse().ok()).unwrap_or(900);
+    let index = |slot: profile::Slot| NAMES.iter().position(|(s, _)| *s == slot).unwrap();
+    let (it, off, gm) = (
+        index(profile::Slot::Iterations),
+        index(profile::Slot::LagOff),
+        index(profile::Slot::Gmres),
+    );
+    let mut sb = PhysicsSandbox::new(scene, 1.0 / 60.0);
+    // (lagged, followed): iterations, ms, steps off, worst ms, most iterations, gmres.
+    let mut sums = [[0.0f64; 6]; 2];
+    for sb_tick in 0..ticks {
+        let bytes = sb.world().to_bytes();
+        for (k, lagged) in [true, false].into_iter().enumerate() {
+            let mut w = World::from_bytes(&bytes).expect("a world");
+            profile::set_lagged(lagged);
+            let _ = profile::take();
+            let t = std::time::Instant::now();
+            w.step();
+            let ms = t.elapsed().as_secs_f64() * 1e3;
+            let p = profile::take();
+            if std::env::var("AB_AT").ok().and_then(|s| s.parse::<usize>().ok()) == Some(sb_tick) {
+                let parts: Vec<String> = NAMES.iter().zip(p).filter(|(_, v)| *v > 0).map(|((slot, name), v)| if is_count(*slot) { format!("{name} {v}") } else { format!("{name} {:.2}", v as f64 / 1e6) }).collect();
+                println!("{} {ms:.2} ms: {}", if lagged { "lagged" } else { "followed" }, parts.join(", "));
+            }
+            let s = &mut sums[k];
+            s[0] += p[it] as f64;
+            s[1] += ms;
+            s[2] += p[off] as f64;
+            s[3] = s[3].max(ms);
+            s[4] = s[4].max(p[it] as f64);
+            s[5] += p[gm] as f64;
+            if k == 1 && std::env::var_os("AB_SHOW").is_some() {
+                eprintln!("tick {} followed {} ms {ms:.2}", sb.world().bodies.len(), p[it]);
+            }
+            if k == 0 && std::env::var_os("AB_SHOW").is_some() {
+                eprintln!("tick lagged {} ms {ms:.2}", p[it]);
+            }
+        }
+        profile::set_lagged(true);
+        sb.step(1.0 / 60.0);
+    }
+    for (name, s) in ["lagged", "followed"].iter().zip(sums) {
+        println!(
+            "{scene:?} {name}: iterations {:.0}, ms {:.0}, steps off {:.0}, worst {:.2} ms, most iterations {:.0}, gmres {:.0}",
+            s[0], s[1], s[2], s[3], s[4], s[5]
+        );
+    }
+}
