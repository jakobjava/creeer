+/// PROBE (ADR-0017's A/B): friction's normal forces lagged as before, not followed.
+#[cfg(feature = "profile")]
+static LAGGED: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// PROBE: sets whether friction's normal forces are lagged (`profile` only).
+pub fn set_lagged(on: bool) {
+    #[cfg(feature = "profile")]
+    LAGGED.store(on, std::sync::atomic::Ordering::Relaxed);
+    #[cfg(not(feature = "profile"))]
+    let _ = on;
