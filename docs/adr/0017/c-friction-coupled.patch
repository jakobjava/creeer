+/// offset + node, rotation at offset + nodes + node).
+fn apply_terms(
+    terms: &[LagTerm],
+    (offsets, nodes, mask): (&[usize], &[usize], &[DVec3]),
+    b2: f64,
+    v: &[DVec3],
+    out: &mut [DVec3],
+) {
+    out.fill(DVec3::ZERO);
+    let at = |(m, n): (usize, usize)| (offsets[m] + n, offsets[m] + nodes[m] + n);
+    for term in terms {
+        let along: f64 = term
+            .iter()
+            .flatten()
+            .map(|&(node, _, psi)| {
+                let (t, r) = at(node);
+                DVec3::from_slice(&psi[..3]).dot(v[t]) + DVec3::from_slice(&psi[3..]).dot(v[r])
