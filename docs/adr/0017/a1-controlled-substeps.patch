+/// Where each node of the bodies would be after a step `h` at its present velocity and
+/// acceleration (the second-order prediction of [`IMPACT_TOLERANCE`]).
+fn predictions(bodies: &[&mut Body], h: f64) -> Vec<Vec<DVec3>> {
+    bodies
+        .iter()
+        .map(|b| {
+            let (s, a) = (&b.structure, b.solver.accelerations());
+            (0..s.node_count())
+                .map(|i| s.position[i] + s.velocity[i] * h + a[i] * (0.5 * h * h))
+                .collect()
+        })
+        .collect()
+}
+
+/// The largest local error of a step (m) at the deforming bodies' nodes: 4/7 of how far
+/// each ended from its `predicted` place.
+fn local_error(bodies: &[&mut Body], predicted: &[Vec<DVec3>]) -> f64 {
+    bodies
+        .iter()
+        .zip(predicted)
+        .filter(|(b, _)| b.structure.element_count() > 0)
+        .flat_map(|(b, p)| b.structure.position.iter().zip(p))
+        .map(|(x, p)| 4.0 / 7.0 * (*x - *p).length())
+        .fold(0.0, f64::max)
+}
