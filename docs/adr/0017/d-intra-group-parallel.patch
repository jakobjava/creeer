+/// What a parallel loop of `items` × `each` µs costs after `gap` µs of serial work.
+#[test]
+#[ignore = "profile"]
+fn rayon_latency() {
+    rayon::join(rayon_latency_in_pool, || ());
+}
+
+fn rayon_latency_in_pool() {
+    println!("on a worker: {:?}", rayon::current_thread_index());
+    use rayon::prelude::*;
+    let spin = |us: f64| {
+        let t = std::time::Instant::now();
+        let mut x = 0u64;
+        while t.elapsed().as_secs_f64() * 1e6 < us {
+            x = x.wrapping_add(1);
+        }
+        x
+    };
+    for (gap, items, each) in [(40.0, 45, 0.8), (40.0, 45, 3.0), (5.0, 45, 0.8), (40.0, 200, 0.8)] {
+        let rounds = 2000;
+        let (mut serial, mut parallel) = (0.0, 0.0);
+        for _ in 0..rounds {
+            spin(gap);
+            let t = std::time::Instant::now();
+            let s: u64 = (0..items).map(|_| spin(each)).sum();
+            serial += t.elapsed().as_secs_f64();
+            spin(gap);
+            let t = std::time::Instant::now();
+            let p: u64 = (0..items).into_par_iter().map(|_| spin(each)).sum();
+            parallel += t.elapsed().as_secs_f64();
+            std::hint::black_box((s, p));
+        }
+        println!(
+            "gap {gap} µs, {items} × {each} µs: serial {:.1} µs, parallel {:.1} µs a loop",
+            serial / f64::from(rounds) * 1e6,
+            parallel / f64::from(rounds) * 1e6
+        );
+    }
+}
+
+/// Where rayon's fixed cost goes: join, chunked loops, broadcast, a pool of its own.
+#[test]
+#[ignore = "probe"]
+fn rayon_overhead() {
+    use rayon::prelude::*;
+    let rounds = 5000;
+    let time = |name: &str, f: &dyn Fn()| {
+        f();
+        let t = std::time::Instant::now();
+        for _ in 0..rounds {
+            f();
+        }
+        println!("{name}: {:.2} µs", t.elapsed().as_secs_f64() / f64::from(rounds) * 1e6);
+    };
+    time("join of two empties", &|| {
+        rayon::join(|| std::hint::black_box(1), || std::hint::black_box(2));
+    });
+    time("par_iter 45 empties", &|| {
+        let s: usize = (0..45usize).into_par_iter().map(std::hint::black_box).sum();
+        std::hint::black_box(s);
+    });
+    time("par_iter 45, min len 6", &|| {
+        let s: usize = (0..45usize).into_par_iter().with_min_len(6).map(std::hint::black_box).sum();
+        std::hint::black_box(s);
+    });
+    let pool = rayon::ThreadPoolBuilder::new().num_threads(8).build().expect("a pool");
+    time("own pool of 8, par_iter 45, min len 6", &|| {
+        pool.install(|| {
+            let s: usize = (0..45usize).into_par_iter().with_min_len(6).map(std::hint::black_box).sum();
+            std::hint::black_box(s);
+        });
+    });
+    println!("threads: {}", rayon::current_num_threads());
+}
+
+/// The latency pattern with rayon's workers kept awake by tasks that yield to pending work.
+#[test]
+#[ignore = "probe"]
+fn rayon_awake() {
+    rayon::join(rayon_awake_in_pool, || ());
+}
+
+fn rayon_awake_in_pool() {
+    use rayon::prelude::*;
+    use std::sync::Arc;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    let spin = |us: f64| {
+        let t = std::time::Instant::now();
+        let mut x = 0u64;
+        while t.elapsed().as_secs_f64() * 1e6 < us {
+            x = x.wrapping_add(1);
+        }
+        x
+    };
+    let helpers: usize = std::env::var("HELPERS").ok().and_then(|s| s.parse().ok()).unwrap_or(7);
+    let alive = Arc::new(AtomicBool::new(true));
+    for _ in 0..helpers {
+        let alive = Arc::clone(&alive);
+        rayon::spawn(move || {
+            while alive.load(Ordering::Relaxed) {
+                if rayon::yield_now() != Some(rayon::Yield::Executed) {
+                    std::hint::spin_loop();
+                }
+            }
+        });
+    }
+    for (gap, items, each) in [(40.0, 45usize, 0.8), (40.0, 45, 3.0), (40.0, 200, 0.8)] {
+        let rounds = 2000;
+        let (mut serial, mut parallel) = (0.0, 0.0);
+        for _ in 0..rounds {
+            spin(gap);
+            let t = std::time::Instant::now();
+            let s: u64 = (0..items).map(|_| spin(each)).sum();
+            serial += t.elapsed().as_secs_f64();
+            spin(gap);
+            let t = std::time::Instant::now();
+            let p: u64 = (0..items)
+                .into_par_iter()
+                .with_min_len(items.div_ceil(helpers + 1))
+                .map(|_| spin(each))
+                .sum();
+            parallel += t.elapsed().as_secs_f64();
+            std::hint::black_box((s, p));
+        }
+        println!(
+            "awake ({helpers}): gap {gap} µs, {items} × {each} µs: serial {:.1} µs, parallel {:.1} µs",
+            serial / f64::from(rounds) * 1e6,
+            parallel / f64::from(rounds) * 1e6
+        );
+    }
+    alive.store(false, Ordering::Relaxed);
+}
