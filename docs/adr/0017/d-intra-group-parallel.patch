+/// Each tick of a scene's run stepped once more from its own saved state, serially and with
+/// the work within groups in parallel (`profile::set_serial`): the same result bit for bit,
+/// and each one's time (`AB_SCENE`, `AB_TICKS`).
+#[test]
+#[ignore = "profile"]
+fn ab_parallel() {
+    use creeer_physics::world::World;
+    let scene = match std::env::var("AB_SCENE").as_deref() {
+        Ok("stacks") => PhysicsScene::Stacks,
+        Ok("crash") => PhysicsScene::Crash,
+        Ok("bridge") => PhysicsScene::Bridge,
+        _ => PhysicsScene::Rocks,
+    };
+    let ticks: usize = std::env::var("AB_TICKS")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(900);
+    let mut sb = PhysicsSandbox::new(scene, 1.0 / 60.0);
+    // (serial, parallel): total ms, worst ms.
+    let mut sums = [[0.0f64; 2]; 2];
+    let mut worst_tick = (0.0, 0.0, 0);
+    for tick in 0..ticks {
+        let bytes = sb.world().to_bytes();
+        let mut after = Vec::new();
+        let mut times = [0.0; 2];
+        for (k, serial) in [true, false].into_iter().enumerate() {
+            let mut w = World::from_bytes(&bytes).expect("a world");
+            profile::set_serial(serial);
+            let _ = profile::take();
+            let t = std::time::Instant::now();
+            w.step();
+            let ms = t.elapsed().as_secs_f64() * 1e3;
+            let p = profile::take();
+            if std::env::var("AB_AT").ok().and_then(|s| s.parse::<usize>().ok()) == Some(tick) {
+                let parts: Vec<String> = NAMES.iter().zip(p).filter(|(_, v)| *v > 0).map(|((slot, name), v)| if is_count(*slot) { format!("{name} {v}") } else { format!("{name} {:.2}", v as f64 / 1e6) }).collect();
+                println!("{} {ms:.2} ms: {}", if serial { "serial" } else { "parallel" }, parts.join(", "));
+            }
+            times[k] = ms;
+            sums[k][0] += ms;
+            sums[k][1] = sums[k][1].max(ms);
+            after.push(w.to_bytes());
+        }
+        assert!(after[0] == after[1], "tick {tick}: parallel differs from serial");
+        if times[0] > worst_tick.0 {
+            worst_tick = (times[0], times[1], tick);
+        }
+        profile::set_serial(false);
+        sb.step(1.0 / 60.0);
+    }
+    println!(
+        "{scene:?}: serial {:.0} ms (worst {:.2}), parallel {:.0} ms (worst {:.2}); serial's worst tick {} took {:.2} -> {:.2} ms",
+        sums[0][0], sums[0][1], sums[1][0], sums[1][1], worst_tick.2, worst_tick.0, worst_tick.1
+    );
+}
