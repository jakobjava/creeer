+/// PROBE (A/B of parallel work within a group): everything within a group serial.
+#[cfg(feature = "profile")]
+static SERIAL: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// PROBE: sets whether work within a group runs serially (`profile` only).
+pub fn set_serial(on: bool) {
+    #[cfg(feature = "profile")]
+    SERIAL.store(on, std::sync::atomic::Ordering::Relaxed);
+    #[cfg(not(feature = "profile"))]
+    let _ = on;
+}
+
+/// PROBE: whether work within a group runs serially (never without `profile`).
+#[inline(always)]
+pub fn serial() -> bool {
+    #[cfg(feature = "profile")]
+    {
+        SERIAL.load(std::sync::atomic::Ordering::Relaxed)
+    }
+    #[cfg(not(feature = "profile"))]
+    {
+        false
+    }
+}
