+//! GPU timestamps per pass (G1.3d, ADR-0026): each pass writes a timestamp where it begins
+//! and where it ends; the frame's stamps are resolved into a buffer and read back a few
+//! frames later, so no frame waits for the GPU. Every GPU budget is measured with them.
+//!
+//! Timestamp queries are an optional feature: on adapters without it the timer is off and
+//! reports nothing.
+
+use std::cell::RefCell;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU8, Ordering};
+
+/// Passes a frame can time.
+const MOST_PASSES: u32 = 32;
+/// Readback buffers in flight: a frame's stamps are read up to this many frames later.
+const IN_FLIGHT: usize = 3;
+/// What a readback buffer is doing (in [`Readback::state`]).
+const FREE: u8 = 0;
+const MAPPING: u8 = 1;
+const MAPPED: u8 = 2;
+
+/// One pass's GPU time in the last frame read back.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct GpuTime {
+    /// The pass.
+    pub name: &'static str,
+    /// Its GPU time (ms).
+    pub ms: f32,
+}
+
+struct Readback {
+    buffer: wgpu::Buffer,
+    state: Arc<AtomicU8>,
+    /// The passes it holds, in order.
+    names: Vec<&'static str>,
+    /// The frame they were recorded in.
+    frame: u64,
+}
+
+/// The frame's query set and the buffers its stamps travel through.
+pub(super) struct GpuTimer {
+    set: wgpu::QuerySet,
+    resolve: wgpu::Buffer,
+    readbacks: Vec<Readback>,
+    /// Nanoseconds per timestamp tick.
+    period: f32,
+    /// The passes timed in the frame being recorded (interior: passes take `&self`).
+    names: RefCell<Vec<&'static str>>,
+    /// The readback the frame being recorded will be copied into.
+    pending: Option<usize>,
+    /// Frames recorded, and the frame `latest` comes from.
+    frames: u64,
+    latest_frame: u64,
+    latest: Vec<GpuTime>,
+}
+
+impl GpuTimer {
+    /// A timer, if the device has timestamp queries.
+    pub(super) fn new(device: &wgpu::Device, queue: &wgpu::Queue) -> Option<Self> {
+        if !device.features().contains(wgpu::Features::TIMESTAMP_QUERY) {
+            return None;
+        }
+        let bytes = u64::from(MOST_PASSES) * 2 * wgpu::QUERY_SIZE as u64;
+        let buffer = |label, usage| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some(label),
+                size: bytes,
+                usage,
+                mapped_at_creation: false,
+            })
+        };
+        Some(Self {
+            set: device.create_query_set(&wgpu::QuerySetDescriptor {
+                label: Some("gpu timer"),
+                ty: wgpu::QueryType::Timestamp,
+                count: MOST_PASSES * 2,
+            }),
+            resolve: buffer(
+                "gpu timer resolve",
+                wgpu::BufferUsages::QUERY_RESOLVE | wgpu::BufferUsages::COPY_SRC,
+            ),
+            readbacks: (0..IN_FLIGHT)
+                .map(|_| Readback {
+                    buffer: buffer(
+                        "gpu timer readback",
+                        wgpu::BufferUsages::COPY_DST | wgpu::BufferUsages::MAP_READ,
+                    ),
+                    state: Arc::new(AtomicU8::new(FREE)),
+                    names: Vec::new(),
+                    frame: 0,
+                })
+                .collect(),
+            period: queue.get_timestamp_period(),
+            names: RefCell::new(Vec::new()),
+            pending: None,
+            frames: 0,
+            latest_frame: 0,
+            latest: Vec::new(),
+        })
+    }
+
+    /// Starts recording a frame. Frames recorded while every readback is still in flight are
+    /// not timed.
+    pub(super) fn begin(&mut self) {
+        self.frames += 1;
+        self.names.get_mut().clear();
+        self.pending = self
+            .readbacks
+            .iter()
+            .position(|r| r.state.load(Ordering::Acquire) == FREE);
+    }
+
+    /// The next two stamps, for the pass `name` (none when the frame is not timed).
+    fn take(&self, name: &'static str) -> Option<(u32, u32)> {
+        self.pending?;
+        let mut names = self.names.borrow_mut();
+        let index = u32::try_from(names.len()).ok()?;
+        if index >= MOST_PASSES {
+            return None;
+        }
+        names.push(name);
+        Some((2 * index, 2 * index + 1))
+    }
+
+    /// Stamps for a render pass named `name`.
+    pub(super) fn render(&self, name: &'static str) -> Option<wgpu::RenderPassTimestampWrites<'_>> {
+        self.take(name)
+            .map(|(begin, end)| wgpu::RenderPassTimestampWrites {
+                query_set: &self.set,
+                beginning_of_pass_write_index: Some(begin),
+                end_of_pass_write_index: Some(end),
+            })
+    }
+
+    /// Stamps for a compute pass named `name`.
+    pub(super) fn compute(
+        &self,
+        name: &'static str,
+    ) -> Option<wgpu::ComputePassTimestampWrites<'_>> {
+        self.take(name)
+            .map(|(begin, end)| wgpu::ComputePassTimestampWrites {
+                query_set: &self.set,
+                beginning_of_pass_write_index: Some(begin),
+                end_of_pass_write_index: Some(end),
+            })
+    }
+
+    /// Resolves the frame's stamps and copies them to its readback (at the frame's end).
+    pub(super) fn resolve(&mut self, encoder: &mut wgpu::CommandEncoder) {
+        let Some(slot) = self.pending else {
+            return;
+        };
+        let names = std::mem::take(self.names.get_mut());
+        if names.is_empty() {
+            self.pending = None;
+            return;
+        }
+        let count = u32::try_from(names.len()).expect("at most MOST_PASSES") * 2;
+        encoder.resolve_query_set(&self.set, 0..count, &self.resolve, 0);
+        let readback = &mut self.readbacks[slot];
+        encoder.copy_buffer_to_buffer(
+            &self.resolve,
+            0,
+            &readback.buffer,
+            0,
+            u64::from(count) * wgpu::QUERY_SIZE as u64,
+        );
+        readback.names = names;
+        readback.frame = self.frames;
+    }
+
+    /// After the frame's submission: asks for its readback to be mapped.
+    pub(super) fn submitted(&mut self) {
+        let Some(slot) = self.pending.take() else {
+            return;
+        };
+        let readback = &self.readbacks[slot];
+        readback.state.store(MAPPING, Ordering::Release);
+        let state = Arc::clone(&readback.state);
+        readback.buffer.map_async(wgpu::MapMode::Read, .., move |result| {
+            // A failed map (device lost) frees the slot; the frame is simply not timed.
+            state.store(if result.is_ok() { MAPPED } else { FREE }, Ordering::Release);
+        });
+    }
+
+    /// Takes in every readback the GPU has finished (the device must have been polled).
+    pub(super) fn collect(&mut self) {
+        for readback in &mut self.readbacks {
+            if readback.state.load(Ordering::Acquire) != MAPPED {
+                continue;
+            }
+            if readback.frame > self.latest_frame {
+                self.latest_frame = readback.frame;
+                let bytes = readback
+                    .buffer
+                    .get_mapped_range(..)
+                    .expect("mapped readback");
+                let stamps: &[u64] = bytemuck::cast_slice(&bytes);
+                self.latest.clear();
+                for (i, &name) in readback.names.iter().enumerate() {
+                    let (begin, end) = (stamps[2 * i], stamps[2 * i + 1]);
+                    // Stamps can wrap; a pass is never negative.
+                    #[allow(clippy::cast_precision_loss)] // ticks of a frame: far below 2^24 ms
+                    let ms = end.saturating_sub(begin) as f32 * self.period * 1e-6;
+                    self.latest.push(GpuTime { name, ms });
+                }
+            }
+            readback.buffer.unmap();
+            readback.state.store(FREE, Ordering::Release);
+        }
+    }
+
+    /// The passes' times in the last frame read back.
+    pub(super) fn latest(&self) -> &[GpuTime] {
+        &self.latest
+    }
+}
diff --git a/crates/creeer_render/src/shaders/ao_common.wgsl b/crates/creeer_render/src/shaders/ao_common.wgsl
new file mode 100644
index 0000000..34876a4
--- /dev/null
+++ b/crates/creeer_render/src/shaders/ao_common.wgsl
@@ -0,0 +1,48 @@
+// Ground-truth ambient occlusion (GTAO; Jimenez et al. 2016), ported from Intel's XeGTAO
+// (MIT, 2021; ADR-0026): what the three compute passes share. View space here is XeGTAO's:
+// x right, y up, z the distance along the view (positive), in metres.
+
+struct Ao {
+    // The grid the occlusion is computed on (pixels), and one over it.
+    size: vec2<f32>,
+    pixel: vec2<f32>,
+    // Screen position (0..1, y down) → view-space x and y at depth 1.
+    ndc_to_view_mul: vec2<f32>,
+    ndc_to_view_add: vec2<f32>,
+    // ndc_to_view_mul × pixel: a pixel's size in view space at depth 1.
+    mul_x_pixel: vec2<f32>,
+    // The near plane (m): reversed-Z infinite depth d is near / z.
+    near: f32,
+    // The effect radius (m), XeGTAO's radius multiplier included.
+    radius: f32,
+    // The part of the radius over which samples fade out.
+    falloff: f32,
+    // Power on the final value (XeGTAO's fit to ray-traced references; 1: the integral).
+    power: f32,
+    // Power on the samples' distances (small crevices weigh more).
+    distribution: f32,
+    // Depth MIP chosen at log2(sample distance) minus this.
+    mip_offset: f32,
+    slices: f32,
+    steps: f32,
+    // MIP of the depth chain that is the grid's own (0 full, 1 half resolution).
+    base_mip: f32,
+    // The denoise's weight on the centre pixel.
+    blur_beta: f32,
+    _pad: vec2<f32>,
+};
+
+@group(0) @binding(0) var<uniform> ao: Ao;
+
+const PI: f32 = 3.14159265;
+// Depths beyond this (m) are the sky.
+const FAR_DEPTH: f32 = 100000.0;
+const DEPTH_MIPS: i32 = 5;
+
+fn view_depth(ndc: f32) -> f32 {
+    return min(ao.near / max(ndc, 1e-30), FAR_DEPTH);
+}
+
+fn view_position(screen: vec2<f32>, z: f32) -> vec3<f32> {
+    return vec3<f32>((ao.ndc_to_view_mul * screen + ao.ndc_to_view_add) * z, z);
+}
diff --git a/crates/creeer_render/src/shaders/ao_composite.wgsl b/crates/creeer_render/src/shaders/ao_composite.wgsl
new file mode 100644
index 0000000..a94134a
--- /dev/null
+++ b/crates/creeer_render/src/shaders/ao_composite.wgsl
@@ -0,0 +1,17 @@
+// Experiment (b): ambient occlusion applied after the scene pass to the ambient light it
+// wrote to its own target (rgb ambient, a albedo luminance).
+
+@group(0) @binding(0) var ambient_map: texture_2d<f32>;
+
+@vertex
+fn vs_main(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let uv = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    return vec4<f32>(uv * 2.0 - 1.0, 0.0, 1.0);
+}
+
+@fragment
+fn fs_main(@builtin(position) p: vec4<f32>) -> @location(0) vec4<f32> {
+    let a = textureLoad(ambient_map, vec2<i32>(p.xy), 0);
+    let occlusion = ambient_occlusion(p.xy, vec3<f32>(a.w), 1.0);
+    return vec4<f32>(a.rgb * (occlusion - 1.0), 0.0);
+}
diff --git a/crates/creeer_render/src/shaders/ao_denoise.wgsl b/crates/creeer_render/src/shaders/ao_denoise.wgsl
new file mode 100644
index 0000000..01a56c0
--- /dev/null
+++ b/crates/creeer_render/src/shaders/ao_denoise.wgsl
@@ -0,0 +1,71 @@
+// GTAO, pass 3 (XeGTAO's Denoise): an edge-aware 3×3 blur, run once or more. Each neighbour
+// weighs as much as the edges between it and this pixel say they share a surface, so the
+// occlusion is smoothed along surfaces but not across their silhouettes.
+
+@group(0) @binding(1) var source: texture_2d<f32>;
+@group(0) @binding(2) var edge_map: texture_2d<f32>;
+@group(0) @binding(3) var out_working: texture_storage_2d<r32float, write>;
+@group(0) @binding(4) var out_final: texture_storage_2d<rgba8unorm, write>;
+
+fn at(p: vec2<i32>) -> f32 {
+    let last = vec2<i32>(ao.size) - 1;
+    return textureLoad(source, clamp(p, vec2<i32>(0), last), 0).r;
+}
+
+fn edges_at(p: vec2<i32>) -> vec4<f32> {
+    let last = vec2<i32>(ao.size) - 1;
+    return textureLoad(edge_map, clamp(p, vec2<i32>(0), last), 0);
+}
+
+/// The blurred value at `p`; `beta` weighs the centre.
+fn blurred(p: vec2<i32>, beta: f32) -> f32 {
+    let l = edges_at(p + vec2<i32>(-1, 0));
+    let r = edges_at(p + vec2<i32>(1, 0));
+    let t = edges_at(p + vec2<i32>(0, -1));
+    let b = edges_at(p + vec2<i32>(0, 1));
+    // Made symmetric: a left edge here is the right edge of the pixel to the left.
+    var c = edges_at(p) * vec4<f32>(l.y, r.x, t.w, b.z);
+    // A little leak where three or four edges meet, against aliasing.
+    let leak_threshold = 2.5;
+    let leak_strength = 0.5;
+    let edginess = clamp(4.0 - leak_threshold - dot(c, vec4<f32>(1.0)), 0.0, 1.0) / (4.0 - leak_threshold) * leak_strength;
+    c = clamp(c + edginess, vec4<f32>(0.0), vec4<f32>(1.0));
+    let diagonal = 0.85 * 0.5;
+    let w_tl = diagonal * (c.x * l.z + c.z * t.x);
+    let w_tr = diagonal * (c.z * t.y + c.y * r.z);
+    let w_bl = diagonal * (c.w * b.x + c.x * l.w);
+    let w_br = diagonal * (c.y * r.w + c.w * b.y);
+    var sum = beta * at(p);
+    var weight = beta;
+    sum += c.x * at(p + vec2<i32>(-1, 0));
+    sum += c.y * at(p + vec2<i32>(1, 0));
+    sum += c.z * at(p + vec2<i32>(0, -1));
+    sum += c.w * at(p + vec2<i32>(0, 1));
+    weight += c.x + c.y + c.z + c.w;
+    sum += w_tl * at(p + vec2<i32>(-1, -1));
+    sum += w_tr * at(p + vec2<i32>(1, -1));
+    sum += w_bl * at(p + vec2<i32>(-1, 1));
+    sum += w_br * at(p + vec2<i32>(1, 1));
+    weight += w_tl + w_tr + w_bl + w_br;
+    return sum / weight;
+}
+
+/// A pass before the last: a gentler blur (XeGTAO: a fifth of the centre's weight).
+@compute @workgroup_size(8, 8)
+fn working(@builtin(global_invocation_id) id: vec3<u32>) {
+    if any(vec2<f32>(id.xy) >= ao.size) {
+        return;
+    }
+    let p = vec2<i32>(id.xy);
+    textureStore(out_working, p, vec4<f32>(blurred(p, ao.blur_beta / 5.0)));
+}
+
+/// The last pass, into the texture the scene reads.
+@compute @workgroup_size(8, 8)
+fn final_pass(@builtin(global_invocation_id) id: vec3<u32>) {
+    if any(vec2<f32>(id.xy) >= ao.size) {
+        return;
+    }
+    let p = vec2<i32>(id.xy);
+    textureStore(out_final, p, vec4<f32>(min(blurred(p, ao.blur_beta), 1.0)));
+}
diff --git a/crates/creeer_render/src/shaders/ao_depth.wgsl b/crates/creeer_render/src/shaders/ao_depth.wgsl
new file mode 100644
index 0000000..156635b
--- /dev/null
+++ b/crates/creeer_render/src/shaders/ao_depth.wgsl
@@ -0,0 +1,79 @@
+// GTAO, pass 1 (XeGTAO's PrefilterDepths16x16): the scene's depth, sample 0 of each pixel,
+// as view-space depth in five MIPs, each a weighted mean of its four texels that leaves out
+// what lies far behind the nearest (so a thin rod in front stays in the coarse MIPs).
+
+@group(0) @binding(1) var depth: texture_depth_multisampled_2d;
+@group(0) @binding(2) var mip0: texture_storage_2d<r32float, write>;
+@group(0) @binding(3) var mip1: texture_storage_2d<r32float, write>;
+@group(0) @binding(4) var mip2: texture_storage_2d<r32float, write>;
+@group(0) @binding(5) var mip3: texture_storage_2d<r32float, write>;
+// WebGPU allows four storage textures a stage: the last MIP is a small pass of its own.
+@group(0) @binding(6) var mip3_read: texture_2d<f32>;
+@group(0) @binding(7) var mip4: texture_storage_2d<r32float, write>;
+
+var<workgroup> scratch: array<array<f32, 8>, 8>;
+
+fn mip_filter(d0: f32, d1: f32, d2: f32, d3: f32) -> f32 {
+    let deepest = max(max(d0, d1), max(d2, d3));
+    // XeGTAO: 0.75 of the radius, found empirically.
+    let radius = 0.75 * ao.radius;
+    let range = ao.falloff * radius;
+    let fade_from = radius * (1.0 - ao.falloff);
+    let mul = -1.0 / range;
+    let add = fade_from / range + 1.0;
+    let w = clamp((vec4<f32>(deepest) - vec4<f32>(d0, d1, d2, d3)) * mul + add, vec4<f32>(0.0), vec4<f32>(1.0));
+    return dot(w, vec4<f32>(d0, d1, d2, d3)) / (w.x + w.y + w.z + w.w);
+}
+
+fn load(p: vec2<i32>) -> f32 {
+    let last = vec2<i32>(textureDimensions(depth)) - 1;
+    return view_depth(textureLoad(depth, clamp(p, vec2<i32>(0), last), 0));
+}
+
+@compute @workgroup_size(8, 8)
+fn prefilter(@builtin(global_invocation_id) id: vec3<u32>, @builtin(local_invocation_id) local: vec3<u32>) {
+    let base = vec2<i32>(id.xy);
+    let p = base * 2;
+    let d0 = load(p);
+    let d1 = load(p + vec2<i32>(1, 0));
+    let d2 = load(p + vec2<i32>(0, 1));
+    let d3 = load(p + vec2<i32>(1, 1));
+    textureStore(mip0, p, vec4<f32>(d0));
+    textureStore(mip0, p + vec2<i32>(1, 0), vec4<f32>(d1));
+    textureStore(mip0, p + vec2<i32>(0, 1), vec4<f32>(d2));
+    textureStore(mip0, p + vec2<i32>(1, 1), vec4<f32>(d3));
+
+    let m1 = mip_filter(d0, d1, d2, d3);
+    textureStore(mip1, base, vec4<f32>(m1));
+    scratch[local.x][local.y] = m1;
+    workgroupBarrier();
+
+    let t = local.xy;
+    if all(t % 2u == vec2<u32>(0u)) {
+        let m2 = mip_filter(
+            scratch[t.x][t.y], scratch[t.x + 1u][t.y], scratch[t.x][t.y + 1u], scratch[t.x + 1u][t.y + 1u],
+        );
+        textureStore(mip2, base / 2, vec4<f32>(m2));
+        scratch[t.x][t.y] = m2;
+    }
+    workgroupBarrier();
+
+    if all(t % 4u == vec2<u32>(0u)) {
+        let m3 = mip_filter(
+            scratch[t.x][t.y], scratch[t.x + 2u][t.y], scratch[t.x][t.y + 2u], scratch[t.x + 2u][t.y + 2u],
+        );
+        textureStore(mip3, base / 4, vec4<f32>(m3));
+    }
+}
+
+/// MIP 4 from MIP 3, one texel a thread.
+@compute @workgroup_size(8, 8)
+fn last_mip(@builtin(global_invocation_id) id: vec3<u32>) {
+    let p = vec2<i32>(id.xy) * 2;
+    let last = vec2<i32>(textureDimensions(mip3_read)) - 1;
+    let d0 = textureLoad(mip3_read, min(p, last), 0).r;
+    let d1 = textureLoad(mip3_read, min(p + vec2<i32>(1, 0), last), 0).r;
+    let d2 = textureLoad(mip3_read, min(p + vec2<i32>(0, 1), last), 0).r;
+    let d3 = textureLoad(mip3_read, min(p + vec2<i32>(1, 1), last), 0).r;
+    textureStore(mip4, vec2<i32>(id.xy), vec4<f32>(mip_filter(d0, d1, d2, d3)));
+}
diff --git a/crates/creeer_render/src/shaders/ao_sample.wgsl b/crates/creeer_render/src/shaders/ao_sample.wgsl
new file mode 100644
index 0000000..405866f
--- /dev/null
+++ b/crates/creeer_render/src/shaders/ao_sample.wgsl
@@ -0,0 +1,29 @@
+// Ambient occlusion as the scene's meshes and terrain read it (G1.3d, `ao_pass.rs`).
+
+@group(3) @binding(0) var ao_map: texture_2d<f32>;
+@group(3) @binding(1) var ao_linear: sampler;
+// x, y: one over the screen's size (pixels); z: 1 when occlusion is on; w: the floor, the
+// darkest it may make the ambient light (`art-style.md` §5).
+@group(3) @binding(2) var<uniform> ao_view: vec4<f32>;
+
+/// GTAO's multi-bounce fit (Jimenez et al. 2016, eq. 10): light bounced within a crease
+/// lightens it more on bright surfaces, so white paint is not greyed like dark rock.
+fn multi_bounce(v: f32, albedo: vec3<f32>) -> vec3<f32> {
+    let a = 2.0404 * albedo - 0.3324;
+    let b = -4.7951 * albedo + 0.6417;
+    let c = 2.7552 * albedo + 0.6903;
+    return max(vec3<f32>(v), ((v * a + b) * v + c) * v);
+}
+
+/// The ambient light's occlusion at the pixel `frag` (its position in pixels) of a surface
+/// of `albedo`: the screen's GTAO with its bounces, no darker than the floor, or `baked`
+/// where that is darker (the lesser of the two, as Filament combines a material's occlusion
+/// with the screen's).
+fn ambient_occlusion(frag: vec2<f32>, albedo: vec3<f32>, baked: f32) -> vec3<f32> {
+    var screen = vec3<f32>(1.0);
+    if ao_view.z > 0.5 {
+        let v = textureSampleLevel(ao_map, ao_linear, frag * ao_view.xy, 0.0).r;
+        screen = max(multi_bounce(v, albedo), vec3<f32>(ao_view.w));
+    }
+    return min(screen, vec3<f32>(baked));
+}
diff --git a/crates/creeer_render/src/shaders/gtao.wgsl b/crates/creeer_render/src/shaders/gtao.wgsl
new file mode 100644
index 0000000..74ee577
--- /dev/null
+++ b/crates/creeer_render/src/shaders/gtao.wgsl
@@ -0,0 +1,175 @@
+// GTAO, pass 2 (XeGTAO's MainPass, normals generated in place from the 32-bit depth): for
+// each pixel, slices through the hemisphere about the view direction; in each, the highest
+// horizon on either side found by stepping out over the depth MIPs, and the cosine-weighted
+// visible arc between them integrated in closed form (Jimenez et al. 2016, Algorithm 1).
+
+@group(0) @binding(1) var depths: texture_2d<f32>;
+@group(0) @binding(2) var nearest: sampler;
+@group(0) @binding(3) var out_ao: texture_storage_2d<r32float, write>;
+@group(0) @binding(4) var out_edges: texture_storage_2d<rgba8unorm, write>;
+
