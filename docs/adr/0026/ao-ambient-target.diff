index 0000000..75b380f
--- /dev/null
+++ b/crates/creeer_render/src/renderer/ao_pass.rs
@@ -0,0 +1,306 @@
+//! Ambient occlusion (G1.3d, ADR-0026): GTAO after XeGTAO, in three compute passes between
+//! the depth prepass and the scene pass. The scene's meshes and terrain read the result and
+//! shade their ambient light with it, never the sun's.
+
+use super::*;
+use ao_textures::AoTextures;
+
+#[path = "ao_textures.rs"]
+mod ao_textures;
+
+/// How much ambient occlusion costs and how good it is (XeGTAO's presets: slices × steps
+/// per side).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub enum AoQuality {
+    /// None: ambient light unoccluded.
+    Off,
+    /// One slice of two steps, at half resolution.
+    Low,
+    /// Two slices of two steps.
+    Medium,
+    /// Three slices of three steps.
+    #[default]
+    High,
+}
+
+impl AoQuality {
+    /// Slices, steps per side, MIP the grid is computed at (0 full, 1 half resolution).
+    fn shape(self) -> Option<(f32, f32, u32)> {
+        match self {
+            Self::Off => None,
+            Self::Low => Some((1.0, 2.0, 1)),
+            Self::Medium => Some((2.0, 2.0, 0)),
+            Self::High => Some((3.0, 3.0, 0)),
+        }
+    }
+}
+
+/// Ambient occlusion's settings (XeGTAO's defaults where not said).
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub struct AoSettings {
+    pub quality: AoQuality,
+    /// The distance occluders count to (m): the length of the rays the ray-traced
+    /// occlusion GTAO is fitted to.
+    pub radius: f32,
+    /// Power on the final value: XeGTAO's 2.2 fits ray-traced references; 1 gives the
+    /// method's own integral (for tests against closed forms).
+    pub power: f32,
+    /// Denoise passes (0: none).
+    pub denoise: u32,
+    /// The darkest the ambient light may become (`art-style.md` §5: creases darken by at
+    /// most half). Tests set 0 to read the raw value.
+    pub floor: f32,
+}
+
+impl Default for AoSettings {
+    fn default() -> Self {
+        Self {
+            quality: AoQuality::default(),
+            radius: 1.0,
+            power: 2.2,
+            denoise: 2,
+            floor: 0.5,
+        }
+    }
+}
+
+/// XeGTAO's tuned constants (`XeGTAO.h`, found by searching for the least error against
+/// ray-traced references).
+const RADIUS_MULTIPLIER: f32 = 1.457;
+const FALLOFF_RANGE: f32 = 0.615;
+const SAMPLE_DISTRIBUTION_POWER: f32 = 2.0;
+const DEPTH_MIP_SAMPLING_OFFSET: f32 = 3.30;
+const DENOISE_BLUR_BETA: f32 = 1.2;
+
+/// The constants the compute passes share (`ao_common.wgsl`).
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod, Zeroable)]
+struct AoConstants {
+    size: [f32; 2],
+    pixel: [f32; 2],
+    ndc_to_view_mul: [f32; 2],
+    ndc_to_view_add: [f32; 2],
+    mul_x_pixel: [f32; 2],
+    near: f32,
+    radius: f32,
+    falloff: f32,
+    power: f32,
+    distribution: f32,
+    mip_offset: f32,
+    slices: f32,
+    steps: f32,
+    base_mip: f32,
+    blur_beta: f32,
+    pad: [f32; 2],
+}
+
+/// What the scene's shaders read (bind group 3): x, y one over the screen's size, z 1 when
+/// occlusion is on, w the floor.
+#[repr(C)]
+#[derive(Clone, Copy, Debug, Pod, Zeroable)]
+struct AoView([f32; 4]);
+
+pub(super) struct AoPass {
+    settings: AoSettings,
+    constants: wgpu::Buffer,
+    view: wgpu::Buffer,
+    prefilter: wgpu::ComputePipeline,
+    last_mip: wgpu::ComputePipeline,
+    main: wgpu::ComputePipeline,
+    working: wgpu::ComputePipeline,
+    final_pass: wgpu::ComputePipeline,
+    layouts: ao_textures::Layouts,
+    textures: AoTextures,
+    /// Read by the scene's mesh and terrain shaders.
+    pub(super) sample_layout: wgpu::BindGroupLayout,
+    pub(super) sample_bind_group: wgpu::BindGroup,
+}
+
+impl AoPass {
+    pub(super) fn new(device: &wgpu::Device, depth: &wgpu::TextureView, size: (u32, u32)) -> Self {
+        let common = include_str!("../shaders/ao_common.wgsl");
+        let module = |label, body: &str| {
+            device.create_shader_module(wgpu::ShaderModuleDescriptor {
+                label: Some(label),
+                source: wgpu::ShaderSource::Wgsl(Cow::Owned(format!("{common}\n{body}"))),
+            })
+        };
+        let layouts = ao_textures::Layouts::new(device);
+        let pipeline = |label, module: &wgpu::ShaderModule, entry, layout| {
+            let layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+                label: Some(label),
+                bind_group_layouts: &[Some(layout)],
+                immediate_size: 0,
+            });
+            device.create_compute_pipeline(&wgpu::ComputePipelineDescriptor {
+                label: Some(label),
+                layout: Some(&layout),
+                module,
+                entry_point: Some(entry),
+                compilation_options: wgpu::PipelineCompilationOptions::default(),
+                cache: None,
+            })
+        };
+        let depth_module = module("ao depth", include_str!("../shaders/ao_depth.wgsl"));
+        let main_module = module("gtao", include_str!("../shaders/gtao.wgsl"));
+        let denoise_module = module("ao denoise", include_str!("../shaders/ao_denoise.wgsl"));
+        let buffer = |label, size: usize| {
+            device.create_buffer(&wgpu::BufferDescriptor {
+                label: Some(label),
+                size: size as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            })
+        };
+        let constants = buffer("ao constants", std::mem::size_of::<AoConstants>());
+        let view = buffer("ao view", std::mem::size_of::<AoView>());
+        let settings = AoSettings::default();
+        let textures = AoTextures::new(device, &layouts, &constants, depth, size, base_mip(settings));
+        let sample_layout = ao_textures::sample_layout(device);
+        let sample_bind_group = textures.sample_bind_group(device, &sample_layout, &view);
+        Self {
+            prefilter: pipeline("ao depth", &depth_module, "prefilter", &layouts.prefilter),
+            last_mip: pipeline("ao last mip", &depth_module, "last_mip", &layouts.last_mip),
+            main: pipeline("gtao", &main_module, "main", &layouts.main),
+            working: pipeline("ao denoise", &denoise_module, "working", &layouts.denoise),
+            final_pass: pipeline("ao denoise", &denoise_module, "final_pass", &layouts.denoise),
+            settings,
+            constants,
+            view,
+            layouts,
+            textures,
+            sample_layout,
+            sample_bind_group,
+        }
+    }
+
+    pub(super) fn settings(&self) -> AoSettings {
+        self.settings
+    }
+
+    /// Changes the settings; the textures follow the resolution they need.
+    pub(super) fn set(&mut self, device: &wgpu::Device, depth: &wgpu::TextureView, settings: AoSettings) {
+        let size = self.textures.full;
+        self.settings = settings;
+        self.resize(device, depth, size);
+    }
+
+    /// Makes the textures for a new screen size (and depth target).
+    pub(super) fn resize(&mut self, device: &wgpu::Device, depth: &wgpu::TextureView, size: (u32, u32)) {
+        self.textures = AoTextures::new(
+            device,
+            &self.layouts,
+            &self.constants,
+            depth,
+            size,
+            base_mip(self.settings),
+        );
+        self.sample_bind_group = self
+            .textures
+            .sample_bind_group(device, &self.sample_layout, &self.view);
+    }
+
+    /// Writes this frame's constants for the camera's projection.
+    pub(super) fn prepare(&self, queue: &wgpu::Queue, camera: &Camera, aspect: f32) {
+        let (w, h) = self.textures.full;
+        #[allow(clippy::cast_precision_loss)] // screen sizes
+        let inverse_full = [1.0 / w as f32, 1.0 / h as f32];
+        let on = self.settings.quality.shape().is_some();
+        let view = AoView([
+            inverse_full[0],
+            inverse_full[1],
+            f32::from(u8::from(on)),
+            self.settings.floor,
+        ]);
+        queue.write_buffer(&self.view, 0, bytemuck::bytes_of(&view));
+        let Some((slices, steps, base)) = self.settings.quality.shape() else {
+            return;
+        };
+        let (gw, gh) = self.textures.grid;
+        #[allow(clippy::cast_precision_loss)]
+        let (size, pixel) = ([gw as f32, gh as f32], [1.0 / gw as f32, 1.0 / gh as f32]);
+        let tan_y = (0.5 * camera.fov_y).tan();
+        let tan_x = tan_y * aspect;
+        let mul = [2.0 * tan_x, -2.0 * tan_y];
+        #[allow(clippy::cast_precision_loss)] // 0 or 1
+        let constants = AoConstants {
+            size,
+            pixel,
+            ndc_to_view_mul: mul,
+            ndc_to_view_add: [-tan_x, tan_y],
+            mul_x_pixel: [mul[0] * pixel[0], mul[1] * pixel[1]],
+            near: camera.near,
+            radius: self.settings.radius * RADIUS_MULTIPLIER,
+            falloff: FALLOFF_RANGE,
+            power: self.settings.power,
+            distribution: SAMPLE_DISTRIBUTION_POWER,
+            mip_offset: DEPTH_MIP_SAMPLING_OFFSET,
+            slices,
+            steps,
+            base_mip: base as f32,
+            // No denoise: the centre outweighs everything (XeGTAO's way of turning it off).
+            blur_beta: if self.settings.denoise == 0 { 1e4 } else { DENOISE_BLUR_BETA },
+            pad: [0.0; 2],
+        };
+        queue.write_buffer(&self.constants, 0, bytemuck::bytes_of(&constants));
+    }
+
+    /// Records the three passes (nothing when off).
+    pub(super) fn encode(&self, encoder: &mut wgpu::CommandEncoder, timer: Option<&super::timing::GpuTimer>) {
+        if self.settings.quality.shape().is_none() {
+            return;
+        }
+        let t = &self.textures;
+        let groups = |(w, h): (u32, u32), tile: u32| (w.div_ceil(tile), h.div_ceil(tile));
+        // A compute pass each, so the profiler times each stage.
+        let mut pass = begin(encoder, timer, "ao depth");
+        pass.set_pipeline(&self.prefilter);
+        pass.set_bind_group(0, &t.prefilter, &[]);
+        let (x, y) = groups(t.full, 16);
+        pass.dispatch_workgroups(x, y, 1);
+        // MIP 4 has a texel for every 16 pixels; one thread each.
+        pass.set_pipeline(&self.last_mip);
+        pass.set_bind_group(0, &t.last_mip, &[]);
+        let (x, y) = groups(t.full, 16 * 8);
+        pass.dispatch_workgroups(x, y, 1);
+        drop(pass);
+        let mut pass = begin(encoder, timer, "ao main");
+        pass.set_pipeline(&self.main);
+        pass.set_bind_group(0, &t.main, &[]);
+        let (x, y) = groups(t.grid, 8);
+        pass.dispatch_workgroups(x, y, 1);
+        drop(pass);
+        let mut pass = begin(encoder, timer, "ao denoise");
+        // a → b → a … then the last into the texture the scene reads.
+        let passes = self.settings.denoise.max(1);
+        for i in 0..passes {
+            let from_a = i % 2 == 0;
+            let group = if from_a { &t.denoise_a } else { &t.denoise_b };
+            let last = i + 1 == passes;
+            pass.set_pipeline(if last { &self.final_pass } else { &self.working });
+            pass.set_bind_group(0, group, &[]);
+            pass.dispatch_workgroups(x, y, 1);
+        }
+    }
+
+    /// The texture of the last occlusion computed (for tests and screenshots).
+    pub(super) fn result(&self) -> (&wgpu::Texture, (u32, u32)) {
+        (&self.textures.result, self.textures.grid)
+    }
+}
+
+fn base_mip(settings: AoSettings) -> u32 {
+    settings.quality.shape().map_or(0, |(_, _, base)| base)
+}
+
+/// A compute pass of its own for a stage of the occlusion, timed under `name`.
+fn begin<'e>(
+    encoder: &'e mut wgpu::CommandEncoder,
+    timer: Option<&super::timing::GpuTimer>,
+    name: &'static str,
+) -> wgpu::ComputePass<'e> {
+    encoder.begin_compute_pass(&wgpu::ComputePassDescriptor {
+        label: Some(name),
+        timestamp_writes: timer.and_then(|t| t.compute(name)),
+    })
+}
diff --git a/crates/creeer_render/src/renderer/ao_textures.rs b/crates/creeer_render/src/renderer/ao_textures.rs
new file mode 100644
index 0000000..cdbfce3
--- /dev/null
+++ b/crates/creeer_render/src/renderer/ao_textures.rs
@@ -0,0 +1,294 @@
+//! Ambient occlusion's textures and bind groups, made for one screen size.
+
+/// MIPs of the view-space depth chain (XeGTAO's `XE_GTAO_DEPTH_MIP_LEVELS`).
+const DEPTH_MIPS: u32 = 5;
+
+/// The compute passes' bind group layouts.
+pub(super) struct Layouts {
+    pub prefilter: wgpu::BindGroupLayout,
+    pub last_mip: wgpu::BindGroupLayout,
+    pub main: wgpu::BindGroupLayout,
+    pub denoise: wgpu::BindGroupLayout,
+}
+
+fn entry(binding: u32, ty: wgpu::BindingType) -> wgpu::BindGroupLayoutEntry {
+    wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::COMPUTE,
+        ty,
+        count: None,
+    }
+}
+
+fn uniform() -> wgpu::BindingType {
+    wgpu::BindingType::Buffer {
+        ty: wgpu::BufferBindingType::Uniform,
+        has_dynamic_offset: false,
+        min_binding_size: None,
+    }
+}
+
+fn storage(format: wgpu::TextureFormat) -> wgpu::BindingType {
+    wgpu::BindingType::StorageTexture {
+        access: wgpu::StorageTextureAccess::WriteOnly,
+        format,
+        view_dimension: wgpu::TextureViewDimension::D2,
+    }
+}
+
+fn unfiltered() -> wgpu::BindingType {
+    wgpu::BindingType::Texture {
+        sample_type: wgpu::TextureSampleType::Float { filterable: false },
+        view_dimension: wgpu::TextureViewDimension::D2,
+        multisampled: false,
+    }
+}
+
+impl Layouts {
+    pub fn new(device: &wgpu::Device) -> Self {
+        let layout = |label, entries: &[wgpu::BindGroupLayoutEntry]| {
+            device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+                label: Some(label),
+                entries,
+            })
+        };
+        let r32 = wgpu::TextureFormat::R32Float;
+        let rgba8 = wgpu::TextureFormat::Rgba8Unorm;
+        let mut prefilter = vec![
+            entry(0, uniform()),
+            entry(
+                1,
+                wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Depth,
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: true,
+                },
+            ),
+        ];
+        prefilter.extend((0..DEPTH_MIPS - 1).map(|m| entry(2 + m, storage(r32))));
+        Self {
+            prefilter: layout("ao depth", &prefilter),
+            last_mip: layout(
+                "ao last mip",
+                &[entry(0, uniform()), entry(6, unfiltered()), entry(7, storage(r32))],
+            ),
+            main: layout(
+                "gtao",
+                &[
+                    entry(0, uniform()),
+                    entry(1, unfiltered()),
+                    entry(2, wgpu::BindingType::Sampler(wgpu::SamplerBindingType::NonFiltering)),
+                    entry(3, storage(r32)),
+                    entry(4, storage(rgba8)),
+                ],
+            ),
+            denoise: layout(
+                "ao denoise",
+                &[
+                    entry(0, uniform()),
+                    entry(1, unfiltered()),
+                    entry(2, unfiltered()),
+                    entry(3, storage(r32)),
+                    entry(4, storage(rgba8)),
+                ],
+            ),
+        }
+    }
+}
+
+/// What the scene's shaders bind to read the occlusion (group 3).
+pub(super) fn sample_layout(device: &wgpu::Device) -> wgpu::BindGroupLayout {
+    let fragment = |binding, ty| wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty,
+        count: None,
+    };
+    device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("ao sample"),
+        entries: &[
+            fragment(
+                0,
+                wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: true },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+            ),
+            fragment(1, wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering)),
+            fragment(2, uniform()),
+        ],
+    })
+}
+
+/// The textures for one screen size and resolution.
+pub(super) struct AoTextures {
+    /// The screen's size, and the grid occlusion is computed on.
+    pub full: (u32, u32),
+    pub grid: (u32, u32),
+    /// The last pass's output, which the scene reads.
+    pub result: wgpu::Texture,
+    pub prefilter: wgpu::BindGroup,
+    pub last_mip: wgpu::BindGroup,
+    pub main: wgpu::BindGroup,
+    /// Denoise reading the main pass's output (a) or the first denoise's (b).
+    pub denoise_a: wgpu::BindGroup,
+    pub denoise_b: wgpu::BindGroup,
+    result_view: wgpu::TextureView,
+    sampler: wgpu::Sampler,
+}
+
+impl AoTextures {
+    pub fn new(
+        device: &wgpu::Device,
+        layouts: &Layouts,
+        constants: &wgpu::Buffer,
+        depth: &wgpu::TextureView,
+        full: (u32, u32),
+        base_mip: u32,
+    ) -> Self {
+        let grid = ((full.0 >> base_mip).max(1), (full.1 >> base_mip).max(1));
+        let texture = |label, (width, height): (u32, u32), format, mips, extra| {
+            device.create_texture(&wgpu::TextureDescriptor {
+                label: Some(label),
+                size: wgpu::Extent3d {
+                    width,
+                    height,
+                    depth_or_array_layers: 1,
+                },
+                mip_level_count: mips,
+                sample_count: 1,
+                dimension: wgpu::TextureDimension::D2,
+                format,
+                usage: wgpu::TextureUsages::STORAGE_BINDING
+                    | wgpu::TextureUsages::TEXTURE_BINDING
+                    | extra,
+                view_formats: &[],
+            })
+        };
+        let r32 = wgpu::TextureFormat::R32Float;
+        let rgba8 = wgpu::TextureFormat::Rgba8Unorm;
+        let none = wgpu::TextureUsages::empty();
+        // Five levels need 16 pixels each way; smaller screens compute on a padded chain.
+        let padded = (full.0.max(16), full.1.max(16));
+        let mips = texture("ao depth mips", padded, r32, DEPTH_MIPS, none);
+        let mip_view = |m| {
+            mips.create_view(&wgpu::TextureViewDescriptor {
+                base_mip_level: m,
+                mip_level_count: Some(1),
+                ..Default::default()
+            })
+        };
+        let mip_views: Vec<_> = (0..DEPTH_MIPS).map(mip_view).collect();
+        let view = |t: &wgpu::Texture| t.create_view(&wgpu::TextureViewDescriptor::default());
+        let a = view(&texture("ao a", grid, r32, 1, none));
+        let b = view(&texture("ao b", grid, r32, 1, none));
+        let edges = view(&texture("ao edges", grid, rgba8, 1, none));
+        let result = texture("ao", grid, rgba8, 1, wgpu::TextureUsages::COPY_SRC);
+        let result_view = view(&result);
+        let group = |label, layout, resources: &[wgpu::BindingResource<'_>]| {
+            let entries: Vec<_> = resources
+                .iter()
+                .enumerate()
+                .map(|(i, resource)| wgpu::BindGroupEntry {
+                    binding: u32::try_from(i).expect("few bindings"),
+                    resource: resource.clone(),
+                })
+                .collect();
+            device.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some(label),
+                layout,
+                entries: &entries,
+            })
+        };
+        let tv = wgpu::BindingResource::TextureView;
+        let mut prefilter = vec![constants.as_entire_binding(), tv(depth)];
+        prefilter.extend(mip_views[..DEPTH_MIPS as usize - 1].iter().map(tv));
+        let last_mip = device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("ao last mip"),
+            layout: &layouts.last_mip,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: constants.as_entire_binding(),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 6,
+                    resource: tv(&mip_views[3]),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 7,
+                    resource: tv(&mip_views[4]),
+                },
+            ],
+        });
+        let nearest = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("ao nearest"),
+            ..Default::default()
+        });
+        let all_mips = view(&mips);
+        let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+            label: Some("ao linear"),
+            mag_filter: wgpu::FilterMode::Linear,
+            min_filter: wgpu::FilterMode::Linear,
+            ..Default::default()
+        });
+        Self {
+            full,
+            grid,
+            prefilter: group("ao depth", &layouts.prefilter, &prefilter),
+            last_mip,
+            main: group(
+                "gtao",
+                &layouts.main,
+                &[
+                    constants.as_entire_binding(),
+                    tv(&all_mips),
+                    wgpu::BindingResource::Sampler(&nearest),
+                    tv(&a),
+                    tv(&edges),
+                ],
+            ),
+            denoise_a: group(
+                "ao denoise a",
+                &layouts.denoise,
+                &[constants.as_entire_binding(), tv(&a), tv(&edges), tv(&b), tv(&result_view)],
+            ),
+            denoise_b: group(
+                "ao denoise b",
+                &layouts.denoise,
+                &[constants.as_entire_binding(), tv(&b), tv(&edges), tv(&a), tv(&result_view)],
+            ),
+            result,
+            result_view,
+            sampler,
+        }
+    }
+
+    /// The bind group the scene reads the occlusion through.
+    pub fn sample_bind_group(
+        &self,
+        device: &wgpu::Device,
+        layout: &wgpu::BindGroupLayout,
+        view: &wgpu::Buffer,
+    ) -> wgpu::BindGroup {
+        device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("ao sample"),
+            layout,
+            entries: &[
+                wgpu::BindGroupEntry {
+                    binding: 0,
+                    resource: wgpu::BindingResource::TextureView(&self.result_view),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 1,
+                    resource: wgpu::BindingResource::Sampler(&self.sampler),
+                },
+                wgpu::BindGroupEntry {
+                    binding: 2,
+                    resource: view.as_entire_binding(),
+                },
+            ],
+        })
+    }
+}
