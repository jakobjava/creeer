@@ -0,0 +1,97 @@
+use super::*;
+
+/// The channels' mean free paths and scales.
+fn channels() -> [(f64, f64); 3] {
+    let paths = mean_free_path();
+    std::array::from_fn(|c| (paths[c], scale(ALBEDO[c])))
+}
+
+#[test]
+fn the_apparent_albedo_inverts_the_diffuse_reflectance() {
+    for reflectance in [0.05, 0.2, 0.339, 0.6] {
+        let alpha = apparent_albedo(reflectance);
+        assert!((diffuse_reflectance(alpha) - reflectance).abs() < 1e-12);
+    }
+    // Skin's mean free paths: red light travels farthest, blue least, each well under 1 mm
+    // (Jensen et al. 2001 measured skin's σ′_s about 0.74-1.0 and σ_a 0.03-0.08 per mm).
+    let [red, green, blue] = mean_free_path();
+    assert!(red > green && green > blue, "{red} {green} {blue}");
+    assert!((0.3..2.0).contains(&red) && blue > 0.05, "{red} {blue}");
+}
+
+#[test]
+fn the_azimuth_integral_has_its_closed_form() {
+    for (a, b) in [(0.3, 0.5), (-0.2, 0.7), (0.9, 0.1), (-0.9, 0.1), (0.0, 1.0)] {
+        let n = 100_000;
+        let numeric: f64 = (0..n)
+            .map(|i| {
+                let psi = (f64::from(i) + 0.5) / f64::from(n) * 2.0 * PI;
+                (a + b * det::cos(psi)).max(0.0)
+            })
+            .sum::<f64>()
+            * 2.0
+            * PI
+            / f64::from(n);
+        assert!((lit_around(a, b) - numeric).abs() < 1e-6, "{a} {b}");
+    }
+}
+
+#[test]
+fn flat_skin_is_lit_as_any_surface_and_curved_skin_glows_past_the_terminator() {
+    for (path, s) in channels() {
+        // A face 10 m across: the cosine itself.
+        for cos_theta in [-0.5, 0.0, 0.3, 1.0] {
+            let flat = scattered(cos_theta, 1e-4, path, s);
+            assert!(
+                (flat - cos_theta.max(0.0)).abs() < 1e-3,
+                "{cos_theta}: {flat}"
+            );
+        }
+    }
+    // A nose's curve (5 mm): light reaches past the terminator, red farthest.
+    let [red, green, blue] = channels().map(|(path, s)| scattered(-0.1, 0.2, path, s));
+    assert!(
+        red > green && green > blue && blue > 0.0,
+        "{red} {green} {blue}"
+    );
+    assert!(red > 0.02, "{red}");
+}
+
+#[test]
+fn scattering_moves_light_but_makes_none() {
+    // Over the whole sphere, the light leaving equals the light arriving: ∫ D sin θ dθ = ½.
+    for (path, s) in channels() {
+        for curvature in [0.05, 0.2, 0.5] {
+            let n = 400;
+            let total: f64 = (0..n)
+                .map(|i| {
+                    let theta = (f64::from(i) + 0.5) / f64::from(n) * PI;
+                    scattered(det::cos(theta), curvature, path, s) * det::sin(theta)
+                })
+                .sum::<f64>()
+                * PI
+                / f64::from(n);
+            assert!((total - 0.5).abs() < 2e-3, "{curvature}: {total}");
+        }
+    }
+}
+
+#[test]
+fn the_table_rises_with_the_light_and_holds_flat_skin_at_its_first_row() {
+    let table = table();
+    assert_eq!(table.len(), SIZE * SIZE);
+    for row in table.chunks(SIZE) {
+        for pair in row.windows(2) {
+            for c in 0..3 {
+                assert!(pair[1][c] >= pair[0][c] - 1e-6, "{pair:?}");
+            }
+        }
+    }
+    // Facing the light on the flattest row: the last column's cosine.
+    let cos_last = 1.0 - 1.0 / SIZE as f32;
+    assert!(
+        (table[SIZE - 1][0] - cos_last).abs() < 1e-3,
+        "{:?}",
+        table[SIZE - 1]
+    );
+}
