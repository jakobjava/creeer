diff --git a/crates/creeer_render/src/shaders/skin_light.wgsl b/crates/creeer_render/src/shaders/skin_light.wgsl
new file mode 100644
index 0000000..8756331
--- /dev/null
+++ b/crates/creeer_render/src/shaders/skin_light.wgsl
@@ -0,0 +1,40 @@
+// Skin lit by the light that scatters beneath it (G1.3i, ADR-0026; renderer side in
+// skin_light.rs): pre-integrated skin shading (Penner and Borshukov 2011). The diffuse light is
+// read from a table by the angle to the sun and the surface's curvature, instead of the plain
+// cosine; the specular is skin's own (index 1.38, Weyrich et al. 2006).
+
+@group(2) @binding(3) var skin_table: texture_2d<f32>;
+@group(2) @binding(4) var skin_sampler: sampler;
+
+// The table's greatest curvature (per mm; skin_light.rs MAX_CURVATURE).
+const SKIN_MAX_CURVATURE: f32 = 0.5;
+// Skin's normal-incidence reflectance: ((1.38 − 1) / (1.38 + 1))².
+const SKIN_F0: f32 = 0.0255;
+
+/// Sunlight reflected by skin of colour `base` towards the viewer, as `direct_light` does for
+/// other surfaces, its diffuse part scattered over a surface of `curvature` (per mm).
+fn skin_direct_light(
+    n: vec3<f32>, v: vec3<f32>, l: vec3<f32>, base: vec3<f32>, roughness: f32,
+    irradiance: vec3<f32>, visibility: f32, curvature: f32,
+) -> vec3<f32> {
+    let h = normalize(l + v);
+    let cos_l = dot(n, l);
+    let ndl = max(cos_l, 0.0);
+    let ndv = max(dot(n, v), 1e-4);
+    let ndh = max(dot(n, h), 0.0);
+    let vdh = max(dot(v, h), 0.0);
+    let fresnel = SKIN_F0 + (1.0 - SKIN_F0) * pow(1.0 - vdh, 5.0);
+    let a = roughness * roughness;
+    let a2 = a * a;
+    let denom = ndh * ndh * (a2 - 1.0) + 1.0;
+    let distribution = a2 / (PI * denom * denom);
+    let k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
+    let geometry = (ndl / (ndl * (1.0 - k) + k)) * (ndv / (ndv * (1.0 - k) + k));
+    let specular = distribution * geometry * fresnel / max(4.0 * ndl * ndv, 1e-4);
+    // The table holds the cosine itself where skin is flat, and light carried past the
+    // terminator where it curves. The shadow still falls on it as on anything (Limits).
+    let uv = vec2<f32>(cos_l * 0.5 + 0.5, clamp(curvature / SKIN_MAX_CURVATURE, 0.0, 1.0));
+    let scattered = textureSampleLevel(skin_table, skin_sampler, uv, 0.0).rgb;
+    let diffuse = (1.0 - SKIN_F0) * base / PI * scattered;
+    return (diffuse + specular * ndl) * irradiance * visibility;
+}
diff --git a/crates/creeer_render/src/skin_light.rs b/crates/creeer_render/src/skin_light.rs
new file mode 100644
index 0000000..c3294d6
--- /dev/null
+++ b/crates/creeer_render/src/skin_light.rs
@@ -0,0 +1,188 @@
+//! Skin lit by the light that scatters beneath it (G1.3i, ADR-0026): pre-integrated skin
+//! shading (Penner and Borshukov, "Pre-Integrated Skin Shading", GPU Pro 2, 2011). Light
+//! entering skin leaves it again millimetres away, red light farthest, so where the light turns
+//! away (the terminator) and on tight curves skin glows warm instead of going grey. Penner
+//! integrates the scattering profile once over curved surfaces, for each angle to the light
+//! and each curvature, into a table the shader reads with the pixel's own.
+//!
+//! The profile is Christensen's ("An Approximate Reflectance Profile for Efficient Subsurface
+//! Scattering", SIGGRAPH 2015 talk): R(d) ∝ (e^(−sd/ℓ) + e^(−sd/3ℓ)) / d, matched to Monte
+//! Carlo references with s = 1.85 − A + 7 (0.8 − A)³ for surface albedo A. Skin's own numbers
+//! are measured (Weyrich et al., "Analysis of Human Faces using a Measurement-Based Skin
+//! Reflectance Model", SIGGRAPH 2006, 149 faces): the effective transport coefficient
+//! σ_tr = 0.5508, 0.9791, 1.5497 per mm in red, green and blue, and the index 1.38. The volume's
+//! mean free path ℓ follows from σ_tr and the apparent albedo α′, which inverts Jensen et al.'s
+//! (2001) diffuse reflectance as Weyrich do.
+//!
+//! Penner integrates over a ring, which needs a profile finite at d = 0; this one is not, so
+//! the table integrates over a sphere of the surface's radius instead, which is finite: there
+//! R(d) d dd is a sum of two exponentials. Its azimuth integral has a closed form.
+
+use crate::half::f16_bits;
+use creeer_math::det;
+use std::f64::consts::PI;
+
+/// The table's side: cosines of the angle to the light across, curvatures down.
+pub const SIZE: usize = 64;
+/// The greatest curvature in the table (per mm): a radius of 2 mm.
+pub const MAX_CURVATURE: f64 = 0.5;
+/// Skin's effective transport coefficient (per mm), red, green, blue (Weyrich et al. 2006,
+/// σ_trAvg: forehead and cheek over all subjects).
+const TRANSPORT: [f64; 3] = [0.5508, 0.9791, 1.5497];
+/// Skin's index of refraction (Weyrich et al. 2006, after Tuchin 2000).
+pub const INDEX: f64 = 1.38;
+/// The surface albedo (linear) the profiles take their shape at: the middle skin tone, 5
+/// (`data/art/people.ron`).
+const ALBEDO: [f64; 3] = [0.339, 0.193, 0.133];
+
+/// Diffuse Fresnel reflectance inside a medium of relative index `eta` (Egan and Hilgeman's
+/// fit, as Jensen et al. 2001 use it).
+fn internal_reflectance(eta: f64) -> f64 {
+    -1.440 / (eta * eta) + 0.710 / eta + 0.668 + 0.0636 * eta
+}
+
+/// Jensen et al.'s (2001) total diffuse reflectance of a half-space of apparent albedo `alpha`.
+fn diffuse_reflectance(alpha: f64) -> f64 {
+    let fdr = internal_reflectance(INDEX);
+    let a = (1.0 + fdr) / (1.0 - fdr);
+    let root = (3.0 * (1.0 - alpha)).sqrt();
+    0.5 * alpha * (1.0 + det::exp(-4.0 / 3.0 * a * root)) * det::exp(-root)
+}
+
+/// The apparent albedo whose diffuse reflectance is `reflectance` (by bisection: it rises with
+/// the albedo).
+fn apparent_albedo(reflectance: f64) -> f64 {
+    let (mut low, mut high) = (0.0, 1.0);
+    for _ in 0..60 {
+        let mid = 0.5 * (low + high);
+        if diffuse_reflectance(mid) < reflectance {
+            low = mid;
+        } else {
+            high = mid;
+        }
+    }
+    0.5 * (low + high)
+}
+
+/// The volume's mean free path ℓ (mm) per channel: σ_tr = σ′_t √(3 (1 − α′)) and ℓ = 1 / σ′_t.
+pub fn mean_free_path() -> [f64; 3] {
+    std::array::from_fn(|c| {
+        let alpha = apparent_albedo(ALBEDO[c]);
+        (3.0 * (1.0 - alpha)).sqrt() / TRANSPORT[c]
+    })
+}
+
+/// Christensen's scale for surface albedo `a`.
+fn scale(a: f64) -> f64 {
+    let x = 0.8 - a;
+    1.85 - a + 7.0 * x * x * x
+}
+
+/// ∫ max(a + b cos ψ, 0) dψ over a full turn, for b ≥ 0.
+fn lit_around(a: f64, b: f64) -> f64 {
+    if a >= b {
+        2.0 * PI * a
+    } else if a <= -b {
+        0.0
+    } else {
+        2.0 * (a * det::acos(-a / b) + (b * b - a * a).sqrt())
+    }
+}
+
+/// The light (relative to a flat surface facing the light) leaving a sphere of `curvature`
+/// (per mm) at angle θ to the light (`cos_theta`), for a channel of mean free path `free_path`
+/// and scale `s`: the sun's cosine at every point of the sphere, weighted by the profile at
+/// its distance.
+pub fn scattered(cos_theta: f64, curvature: f64, free_path: f64, s: f64) -> f64 {
+    let sin_theta = (1.0 - cos_theta * cos_theta).max(0.0).sqrt();
+    let radius = 1.0 / curvature.max(1e-6);
+    // Over distance d along the chord: R(d) d dd = e^(−sd/ℓ) + e^(−sd/3ℓ), to e^-10 of the
+    // slower term or the far side of the sphere. Simpson's rule.
+    let reach = (30.0 * free_path / s).min(2.0 * radius);
+    let steps = 512;
+    let h = reach / f64::from(steps);
+    let (mut lit, mut total) = (0.0, 0.0);
+    for i in 0..=steps {
+        let d = f64::from(i) * h;
+        let weight = if i == 0 || i == steps {
+            1.0
+        } else if i % 2 == 1 {
+            4.0
+        } else {
+            2.0
+        };
+        let profile = det::exp(-s * d / free_path) + det::exp(-s * d / (3.0 * free_path));
+        // The point d away subtends φ at the centre: cos φ = 1 − d² / 2ρ².
+        let cos_phi = (1.0 - d * d / (2.0 * radius * radius)).clamp(-1.0, 1.0);
+        let sin_phi = (1.0 - cos_phi * cos_phi).max(0.0).sqrt();
+        let around = lit_around(cos_theta * cos_phi, sin_theta * sin_phi);
+        lit += weight * profile * around;
+        total += weight * profile * 2.0 * PI;
+    }
+    lit / total
+}
+
+/// The table, row by row from curvature 0 to [`MAX_CURVATURE`], each from cos θ = −1 to 1 at
+/// texel centres: red, green, blue scattered light, alpha 1.
+pub fn table() -> Vec<[f32; 4]> {
+    let paths = mean_free_path();
+    let scales = ALBEDO.map(scale);
+    let centre = |i: usize| (i as f64 + 0.5) / SIZE as f64;
+    let mut out = Vec::with_capacity(SIZE * SIZE);
+    for row in 0..SIZE {
+        let curvature = centre(row) * MAX_CURVATURE;
+        for column in 0..SIZE {
+            let cos_theta = centre(column) * 2.0 - 1.0;
+            #[allow(clippy::cast_possible_truncation)] // a table of light
+            let channel = |c: usize| scattered(cos_theta, curvature, paths[c], scales[c]) as f32;
+            out.push([channel(0), channel(1), channel(2), 1.0]);
+        }
+    }
+    out
+}
+
+/// The table on the GPU (`Rgba16Float`, filtered, clamped at its edges).
+pub(crate) fn upload(
+    device: &wgpu::Device,
+    queue: &wgpu::Queue,
+) -> (wgpu::TextureView, wgpu::Sampler) {
+    let bits: Vec<u16> = table().iter().flatten().map(|&v| f16_bits(v)).collect();
+    #[allow(clippy::cast_possible_truncation)] // 64
+    let side = SIZE as u32;
+    let texture = wgpu::util::DeviceExt::create_texture_with_data(
+        device,
+        queue,
+        &wgpu::TextureDescriptor {
+            label: Some("skin light"),
+            size: wgpu::Extent3d {
+                width: side,
+                height: side,
+                depth_or_array_layers: 1,
+            },
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba16Float,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        },
+        wgpu::util::TextureDataOrder::LayerMajor,
+        bytemuck::cast_slice(&bits),
+    );
+    let sampler = device.create_sampler(&wgpu::SamplerDescriptor {
+        label: Some("skin light"),
+        address_mode_u: wgpu::AddressMode::ClampToEdge,
+        address_mode_v: wgpu::AddressMode::ClampToEdge,
+        mag_filter: wgpu::FilterMode::Linear,
+        min_filter: wgpu::FilterMode::Linear,
+        ..Default::default()
+    });
+    (
+        texture.create_view(&wgpu::TextureViewDescriptor::default()),
+        sampler,
+    )
+}
+
