index 0000000..96ce52a
--- /dev/null
+++ b/crates/creeer_physics/src/world/contact/trace.rs
@@ -0,0 +1,84 @@
+//! TEMP: G2.0 trace of each contact's elastic energy, matched from step to step.
+
+use super::{Contacts, Law, Side};
+use crate::structure::group::MemberState;
+use std::sync::Mutex;
+
+static LAST: Mutex<Vec<(String, f64, f64)>> = Mutex::new(Vec::new());
+
+impl Contacts {
+    fn keyed(&self, states: &[MemberState<'_>]) -> Vec<(String, f64, f64)> {
+        let geometry = self.geometry(states);
+        let gaps = geometry.gaps();
+        let measured = &*geometry.measured;
+        let key = |i: usize, kind: &str| {
+            let c = &self.list[i];
+            let (m, l) = match c.a {
+                Side::Node { local, member, .. } => (member, local),
+                Side::Fixed(p) => (9, p),
+            };
+            let b = match c.b {
+                Side::Node { member, .. } => format!("{member}"),
+                Side::Fixed(_) => "g".to_string(),
+            };
+            let bump = if c.bump { "bump" } else { "" };
+            format!("{kind}{bump}{m}{b}({:+.2},{:+.2},{:+.2})", l.x, l.y, l.z)
+        };
+        let mut out = Vec::new();
+        for (i, c) in self.list.iter().enumerate() {
+            if let Law::Hertz(h) = c.law {
+                out.push((key(i, "pt"), h.energy(-gaps[i]), gaps[i]));
+            }
+        }
+        for (p, m) in self.patches.iter().zip(measured) {
+            let depths: [f64; 4] = std::array::from_fn(|k| -gaps[p.first + k]);
+            let e = p.evaluate_on(depths, m).0;
+            let least = m.iter().copied().fold(f64::NEG_INFINITY, f64::max);
+            let k = key(p.first, "pa") + &key(p.first + 2, "");
+            out.push((k, e, -least));
+        }
+        out
+    }
+
+    /// Prints the contacts found at `states` against the last step's end.
+    pub fn trace_start(&self, states: &[MemberState<'_>]) {
+        let now = self.keyed(states);
+        let last = LAST.lock().expect("trace");
+        let mut lines = Vec::new();
+        let (mut e_now, mut e_last) = (0.0, 0.0);
+        for (k, e, g) in &now {
+            e_now += e;
+            let before = last.iter().find(|(l, _, _)| l == k);
+            let eb = before.map_or(0.0, |b| b.1);
+            if (e - eb).abs() > 1e-4 {
+                lines.push(format!(
+                    "    {k} {:.2}mJ (was {}) gap {:.0}um",
+                    e * 1e3,
+                    before.map_or("new".to_string(), |b| format!("{:.2}mJ gap {:.0}um", b.1 * 1e3, b.2 * 1e6)),
+                    g * 1e6
+                ));
+            }
+        }
+        for (k, e, g) in last.iter() {
+            e_last += e;
+            if !now.iter().any(|(n, _, _)| n == k) && *e > 1e-4 {
+                lines.push(format!("    {k} gone, held {:.2}mJ gap {:.0}um", e * 1e3, g * 1e6));
+            }
+        }
+        eprintln!(
+            "  found {:.2}mJ in {} against {:.2}mJ in {}",
+            e_now * 1e3,
+            now.len(),
+            e_last * 1e3,
+            last.len()
+        );
+        for l in lines {
+            eprintln!("{l}");
+        }
+    }
+
+    /// Keeps the contacts at the step's end.
+    pub fn trace_end(&self, states: &[MemberState<'_>]) {
+        *LAST.lock().expect("trace") = self.keyed(states);
+    }
+}
