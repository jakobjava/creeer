+        .unwrap_or(5);
+    let cache = std::env::var("CACHE").ok().map(|c| {
+        let t = std::env::var("TRUNKS").unwrap_or_default().replace(',', "_");
+        format!("{c}.{b}.{t}.bin")
+    });
+    let all = &play.server.world.world;
+    let fresh = |all: &World| {
+        let mut w = World::new(all.dt());
+        w.ground = all.ground.clone();
+        w.static_friction = all.static_friction;
+        w.static_surface = all.static_surface;
+        w
+    };
+    if let Some(bytes) = cache.as_ref().and_then(|c| std::fs::read(c).ok()) {
+        let mut w = World::from_bytes(&bytes).expect("cached");
+        w.ground = all.ground.clone();
+        return w;
+    }
+    let mut w = fresh(all);
+    let still = vec![Act::default(); s.players.len()];
+    for tick in 0..1800 {
+        let acts = (s.script)(tick, &play);
+        play.tick(&acts);
+    }
+    for _ in 0..600 {
+        play.tick(&still);
+    }
+    let all = &play.server.world.world;
+    for (i, body) in all.bodies.iter().enumerate() {
+        println!(
+            "body {i}: m={:.1} asleep={} held={} shapes={} nodes={}",
+            body.structure.total_mass(),
+            body.sleep.asleep,
+            body.held,
+            body.shapes.len(),
+            body.structure.node_count()
+        );
+    }
+    let list: Vec<usize> = std::env::var("TRUNKS").ok().map_or(vec![b], |t| {
+        t.split(',').filter_map(|x| x.parse().ok()).collect()
+    });
+    for &i in &list {
+        w.add(all.bodies[i].clone());
+    }
+    if let Some(mu) = std::env::var("MU").ok().and_then(|m| m.parse::<f64>().ok()) {
+        w.bodies[0].friction = mu;
+        w.static_friction = mu;
+    }
+    for _ in 0..120 {
+        w.step();
+    }
+    if let Some(c) = &cache {
+        std::fs::write(c, w.to_bytes()).expect("cache written");
+    }
+    w
+}
+
+fn kinetic(w: &World) -> f64 {
+    let s = &w.bodies[0].structure;
+    let r = DMat3::from_quat(s.orientation[0]);
+    let om = s.angular_velocity[0];
+    0.5 * s.total_mass() * s.velocity[0].length_squared()
+        + 0.5 * om.dot(r * s.inertia_of(0) * r.transpose() * om)
+}
