+#[test]
+#[ignore = "a measurement, run by hand"]
+fn rest_probe_detail() {
+    let mut w = trunk_alone();
+    {
+        let s = &w.bodies[0].structure;
+        let r = DMat3::from_quat(s.orientation[0]);
+        println!(
+            "mass {:.1} I={:?} axes x={:.3?} y={:.3?} z={:.3?} up={:.3?} g={:.3?} shapes={}",
+            s.total_mass(),
+            s.inertia_of(0),
+            r.col(0),
+            r.col(1),
+            r.col(2),
+            s.position[0].normalize(),
+            s.gravity,
+            w.bodies[0].shapes.len()
+        );
+    }
+    let trace = std::env::var("GUARD").is_ok();
+    let p0 = w.bodies[0].structure.position[0];
+    let ticks: usize = std::env::var("TICKS")
+        .ok()
+        .and_then(|t| t.parse().ok())
+        .unwrap_or(40);
+    let mut asleep_at = None;
+    for tick in 0..ticks {
+        let q_before = w.bodies[0].structure.orientation[0];
+        let x_before = w.bodies[0].structure.position[0];
+        creeer_physics::structure::group::TRACE.store(trace, std::sync::atomic::Ordering::Relaxed);
+        w.step();
+        creeer_physics::structure::group::TRACE.store(false, std::sync::atomic::Ordering::Relaxed);
+        let body = &w.bodies[0];
+        if body.sleep.asleep && asleep_at.is_none() {
+            asleep_at = Some(tick);
+        }
+        let s = &body.structure;
+        let r = DMat3::from_quat(s.orientation[0]);
+        let d = (s.position[0] - p0) * 1e6;
+        let step = (s.position[0] - x_before) * 1e6;
+        let turn = r.transpose() * (s.orientation[0] * q_before.inverse()).to_scaled_axis() * 1e6;
+        let (mut patches, mut points, mut fresh, mut lambda) = (0, 0, 0, 0.0);
+        let mut force = DVec3::ZERO;
+        for c in &w.contacts {
+            match c.law {
+                Law::Patch { vertex: 0, .. } => patches += 1,
+                Law::Patch { .. } => {}
+                Law::Hertz(_) => points += 1,
+            }
+            if c.anchor == c.b {
+                fresh += 1;
+            }
+            lambda += c.normal_force();
+            force += c.normal * c.normal_force();
+        }
+        println!(
+            "{tick:3} ke={:8.3}mJ dx=({:+6.0},{:+6.0},{:+6.0}) step={:5.0}um turn(body)=({:+5.0},{:+5.0},{:+5.0})urad v={:.1}mm/s it={:2} fb={} n={} pa={patches} pt={points} fresh={fresh} sl={lambda:.0} F={force:.0?}{}",
+            kinetic(&w) * 1e3,
+            d.x,
+            d.y,
+            d.z,
+            step.length(),
+            turn.x,
+            turn.y,
+            turn.z,
+            s.velocity[0].length() * 1e3,
+            body.solver.last_iterations,
+            body.solver.fallbacks,
+            w.contacts.len(),
+            if body.sleep.asleep { " Z" } else { "" }
+        );
+    }
+    println!("asleep at {asleep_at:?}");
+}
+
+#[test]
+#[ignore = "a measurement, run by hand"]
+fn rest_probe_group() {
+    use creeer_physics::world::contact::Side;
+    let s = scene("lumberjack").expect("the scene");
+    let terrain = terrain();
+    let mut play = Play::new((s.build)(terrain.clone()), s.name, s.players, &terrain);
+    let still = vec![Act::default(); s.players.len()];
+    for tick in 0..1800 {
+        let acts = (s.script)(tick, &play);
+        play.tick(&acts);
+    }
+    let idle: usize = std::env::var("IDLE")
+        .ok()
+        .and_then(|t| t.parse().ok())
+        .unwrap_or(0);
+    for _ in 0..idle {
+        play.tick(&still);
+    }
+    let trace = std::env::var("GUARD").is_ok();
+    let ticks: usize = std::env::var("TICKS")
+        .ok()
+        .and_then(|t| t.parse().ok())
+        .unwrap_or(40);
+    for tick in 0..ticks {
+        let w = &play.server.world.world;
+        let before: Vec<_> = (w.bodies.iter())
+            .map(|b| (b.structure.position[0], b.structure.orientation[0]))
+            .collect();
+        creeer_physics::structure::group::TRACE.store(trace, std::sync::atomic::Ordering::Relaxed);
+        let ms = play.tick(&still).ms;
+        creeer_physics::structure::group::TRACE.store(false, std::sync::atomic::Ordering::Relaxed);
+        let w = &play.server.world.world;
+        let mut line = format!("{tick:3} {ms:.1}ms");
+        for (i, b) in w.bodies.iter().enumerate() {
+            if b.sleep.asleep || b.held || i >= before.len() {
+                continue;
+            }
+            let s = &b.structure;
+            let r = DMat3::from_quat(s.orientation[0]);
+            let step = (s.position[0] - before[i].0) * 1e6;
+            let turn =
+                r.transpose() * (s.orientation[0] * before[i].1.inverse()).to_scaled_axis() * 1e6;
+            let om = s.angular_velocity[0];
+            let ke = 0.5 * s.total_mass() * s.velocity[0].length_squared()
+                + 0.5 * om.dot(r * s.inertia_of(0) * r.transpose() * om);
+            line += &format!(
+                " [{i}{} ke={:.2}mJ step={:.0}um turn=({:+.0},{:+.0},{:+.0})ur it={} fb={}]",
+                if b.sleep.asleep { "Z" } else { "" },
+                ke * 1e3,
+                step.length(),
+                turn.x,
+                turn.y,
+                turn.z,
+                b.solver.last_iterations,
+                b.solver.fallbacks
+            );
+        }
+        let groups: Vec<&[usize]> = w.groups().filter(|g| g.len() > 1 || !w.bodies[g[0]].held).collect();
+        let _ = Side::Fixed(DVec3::ZERO);
+        println!("{line} groups={groups:?} contacts={}", w.contacts.len());
+    }
+}
