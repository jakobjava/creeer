+//! Felled logs come to rest (G2.0, ADR-0024): a long twelve-sided log on rough sloping ground,
+//! and a log lying across another.
+
+use super::hull::Hull;
+use super::planet_tests::FieldGround;
+use super::shape::Shape;
+use super::surface::Surface;
+use super::*;
+use creeer_math::det;
+use std::sync::Arc;
+
+const DT: f64 = 1.0 / 60.0;
+
+/// A log's stem as a felled tree's (`creeer_sim::trees::felled`): twelve-sided rings every
+/// 3 m along z, tapering from `r0` to `r1` (faster towards its top, so its faces bend at
+/// every ring), `length` long.
+fn stem(length: f64, r0: f64, r1: f64) -> Vec<DVec3> {
+    let rings = (length / 3.0).ceil().max(1.0);
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)] // a few rings
+    let n = rings as u32;
+    let mut points = Vec::new();
+    for k in 0..=n {
+        let t = f64::from(k) / f64::from(n);
+        let r = r0 + (r1 - r0) * det::pow(t, 0.7);
+        for c in 0..12 {
+            let a = f64::from(c) * std::f64::consts::TAU / 12.0;
+            let (s, co) = det::sin_cos(a);
+            points.push(DVec3::new(r * co, r * s, (t - 0.5) * length));
+        }
+    }
+    points
+}
+
+/// A log of wood (700 kg/m³) with a crown's mass beyond its top: its node at the centre of
+/// mass, `offset` along its axis from its hull's centroid, as `Hull::about` puts a felled
+/// tree's.
+fn log(length: f64, r0: f64, r1: f64, offset: f64, at: DVec3, turn: DQuat) -> Body {
+    let (hull, _) = Hull::new(&stem(length, r0, r1)).expect("a stem");
+    let mass = 700.0 * hull.volume();
+    let inertia = hull.inertia(mass) + DMat3::from_diagonal(DVec3::new(1.0, 1.0, 0.0))
+        * (mass * offset * offset);
+    let hull = hull.about(DVec3::Z * offset);
+    let mut body = Body::rigid_with(Shape::Hull(Arc::new(hull)), mass, inertia, at, DT);
+    body.structure.orientation[0] = turn;
+    body.friction = 0.6;
+    body.restitution = 0.1;
+    body.solver.reset_history(&body.structure);
+    body
+}
+
+/// Rough sloping ground as the terrain's (`creeer_terrain::tiles`): heights on a 1 m lattice,
+/// 7° down +x with swells of 5 cm some 9 m apart and 1 cm of roughness from node to node,
+/// joined by Catmull–Rom splines (its slope continuous, its curvature not).
+fn rough(p: DVec3) -> f64 {
+    let node = |i: f64, j: f64| {
+        let swell = 0.05 * det::sin(0.7 * i) * det::sin(0.6 * j + 0.4);
+        let hash = det::sin(i * 12.9898 + j * 78.233) * 43_758.545;
+        -0.07 * i + swell + 0.01 * (hash - hash.floor() - 0.5)
+    };
+    let spline = |f: f64| {
+        let (f2, f3) = (f * f, f * f * f);
+        [
+            -0.5 * f3 + f2 - 0.5 * f,
+            1.5 * f3 - 2.5 * f2 + 1.0,
+            -1.5 * f3 + 2.0 * f2 + 0.5 * f,
+            0.5 * f3 - 0.5 * f2,
+        ]
+    };
+    let (i, j) = (p.x.floor(), p.z.floor());
+    let (wx, wz) = (spline(p.x - i), spline(p.z - j));
+    let mut height = 0.0;
+    for (a, wa) in wx.iter().enumerate() {
+        for (b, wb) in wz.iter().enumerate() {
+            #[allow(clippy::cast_precision_loss)] // 0..4
+            let (da, db) = (a as f64 - 1.0, b as f64 - 1.0);
+            height += wa * wb * node(i + da, j + db);
+        }
+    }
+    p.y - height
+}
+
+/// Puts a body's lowest corner 2 mm over the ground `ground` (a height field's density).
+fn set_down(body: &mut Body, ground: impl Fn(DVec3) -> f64) {
+    let Shape::Hull(hull) = &body.shapes[0].1 else {
+        panic!("a hull");
+    };
+    let s = &mut body.structure;
+    let lowest = (hull.vertices().iter())
+        .map(|&v| ground(s.position[0] + s.orientation[0] * v))
+        .fold(f64::INFINITY, f64::min);
+    s.position[0].y += 0.0005 - lowest;
+}
+
+/// Steps `world` until every body sleeps or `seconds` pass: when they all slept (s).
+fn asleep_after(world: &mut World, seconds: f64) -> Option<f64> {
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss)] // a few thousand
+    let ticks = (seconds / DT) as u32;
+    let from: u32 = std::env::var("TRACE_FROM")
+        .ok()
+        .and_then(|t| t.parse().ok())
+        .unwrap_or(u32::MAX);
+    for tick in 0..ticks {
+        let on = tick >= from && tick < from + 15;
+        crate::structure::group::TRACE.store(on, std::sync::atomic::Ordering::Relaxed);
+        let before = world.bodies[0].structure.orientation[0];
+        world.step();
+        crate::structure::group::TRACE.store(false, std::sync::atomic::Ordering::Relaxed);
+        if on {
+            let s = &world.bodies[0].structure;
+            let r = DMat3::from_quat(s.orientation[0]);
+            let turn = r.transpose() * (s.orientation[0] * before.inverse()).to_scaled_axis();
+            eprintln!(
+                "{tick}: v {:.2e} turn {:.0?} urad, {} contacts",
+                s.velocity[0].length(),
+                turn * 1e6,
+                world.contacts.len()
+            );
+        }
+        if tick % 30 == 0 {
+            let bumps = world.contacts.iter().filter(|c| c.bump).count();
+            let s = &world.bodies[0].structure;
+            eprintln!(
+                "  {tick}: {} contacts, {bumps} bumps, v {:.2e} w {:.2e}",
+                world.contacts.len(),
+                s.velocity[0].length(),
+                s.angular_velocity[0].length()
+            );
+        }
+        if world.bodies.iter().all(|b| b.sleep.asleep) {
+            return Some(f64::from(tick) * DT);
+        }
+    }
+    None
+}
+
+/// A 12 m log laid across the slope of rough ground comes to rest and sleeps within 4 s,
+/// without creeping. (Each step found the ground's bumps afresh: one 20 µm in was not found
+/// the next step, the log sank into it unopposed and found it again holding 37 mJ, which
+/// threw it 1–2 mm; it never rested, G2.0.)
+#[test]
+fn a_log_rests_on_rough_sloping_ground() {
+    let mut late = Vec::new();
+    for (case, (z, roll)) in [(0.0, 0.0), (1.3, 0.1), (-2.1, 0.25), (0.7, 0.4)]
+        .into_iter()
+        .enumerate()
+    {
+        let mut world = World::new(DT);
+        world.ground = Some(Arc::new(FieldGround(rough)));
+        world.static_friction = 0.6;
+        // Across the slope: its axis along z, its lowest face down.
+        let turn = rotation(DVec3::Z, roll) * rotation(DVec3::Z, std::f64::consts::PI / 12.0);
+        world.add(log(12.0, 0.2, 0.08, 1.5, DVec3::new(0.0, 0.0, z), turn));
+        set_down(&mut world.bodies[0], rough);
+        let slept = asleep_after(&mut world, 8.0);
+        let s = &world.bodies[0].structure;
+        eprintln!(
+            "case {case}: asleep {slept:?}, moving at {} m/s, {} rad/s",
+            s.velocity[0].length(),
+            s.angular_velocity[0].length()
+        );
+        late.extend(slept.is_none_or(|t| t >= 4.0).then_some((case, slept)));
+    }
+    assert!(late.is_empty(), "{late:?}");
+}
