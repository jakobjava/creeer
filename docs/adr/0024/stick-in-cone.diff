--- /dev/null
+++ b/crates/creeer_physics/src/world/contact/stick.rs
@@ -0,0 +1,113 @@
+//! Static friction's spring damped within Coulomb's cone (ADR-0024, "G2.0: sticking contacts
+//! at rest").
+//!
+//! Static friction is a spring between A's point and its anchor on B, of stiffness
+//! k = 2·μ·λ/e at rest (`mod.rs`, e the stick distance), and elastic: its energy comes back.
+//! A felled log balanced across another, its ends on the ground carrying 0–2 N, rocked on
+//! those soft springs at 3 Hz for good, its energy constant to 10⁻⁷ J, and never slept. The
+//! stick spring stands for a real contact's tangential compliance, which is far stiffer
+//! (Mindlin's 8·G*·a) and whose vibration dies in the contact (microslip, Johnson §7.4); its
+//! own ringing, slow because it is soft, is the model's, as an undamped normal penalty's would
+//! be. So it is damped critically, as the normal dashpot damps the penetration: c = 2·√(k·m),
+//! m the contact's effective mass.
+//!
+//! Within the cone, not beside it. Discrete element codes damp the tangential spring and cap
+//! the sum of spring and dashpot at μ·F_n (Cundall & Strack 1979; Tsuji et al. 1992; LAMMPS'
+//! and LIGGGHTS' history models rescale the spring so that |k·u + c·u̇| ≤ μ·F_n); engines'
+//! impulse friction is the limit of the same, all tangential motion taken within the cone
+//! (Moreau's maximal dissipation; Box2D, PhysX, Bullet). A dashpot added to Coulomb's force
+//! instead held a wedge sliding down a 40° ramp at 1 cm/s; capped at a tenth of μ·λ beside it,
+//! it broke accuracy tests unless gated to resting contacts, and gated it decided sleep either
+//! way (`docs/adr/0024/sticking-dashpot.diff`).
+//!
+//! So the friction law's argument is the damped slip s = u + γ·u̇, γ = c/k the spring's time
+//! constant, u̇ = (u − u_r)/β the scheme's rate of the slip from its reference at x̂ (as the
+//! normal dashpot's, `dashpot.rs`): within the step s = (1 + d)·u − d·u_r, d = γ/β, affine in
+//! the unknowns. Its energy μ·λ·f₀(|s|)/(1 + d) has the force μ·λ·f₀'(|s|)·ŝ: the spring and
+//! its dashpot, k·u + c·u̇, while it sticks, and never more than μ·λ. A contact at rest has
+//! u̇ = 0 and holds what it held; one that slides keeps Coulomb's μ·λ, along u + γ·u̇.
+
+use super::{Contacts, point};
+use crate::structure::group::MemberState;
+use creeer_math::glam::DVec3;
+
+/// One contact's damped slip for the step: its reference slip at x̂ and d = γ/β.
+#[derive(Clone, Copy, Debug, Default)]
+pub(super) struct Damped {
+    reference: DVec3,
+    ratio: f64,
+}
+
+impl Contacts {
+    /// Sets each contact's damped slip for the step (`start`, `previous`: the members at the
+    /// step's start and one step before; `ahead` = τ/h). After the normal forces λ are set.
+    /// Contacts with spheres (friction at carried points) and impact substeps' (no dashpots)
+    /// keep their friction undamped.
+    pub(super) fn start_stick_dashpots(
+        &mut self,
+        start: &[MemberState<'_>],
+        previous: &[MemberState<'_>],
+        ahead: f64,
+    ) {
+        self.stick.clear();
+        for c in &self.list {
+            if !c.dashpot || c.rolls() || c.friction <= 0.0 {
+                self.stick.push(Damped::default());
+                continue;
+            }
+            let slip = |states: &[MemberState<'_>]| {
+                let travel = point(c.a, states).0 - point(c.anchor, states).0;
+                travel - c.normal * c.normal.dot(travel)
+            };
+            let (now, then) = (slip(start), slip(previous));
+            self.stick.push(Damped {
+                reference: now + (now - then) * ahead,
+                ratio: 0.0,
+            });
+        }
+        self.set_stick_ratios();
+    }
+
+    /// Each damped contact's d = γ/β for its normal force λ as it is now (at the step's start
+    /// and again at each refresh of λ): critical for the spring friction has at that λ.
+    pub(super) fn set_stick_ratios(&mut self) {
+        for (c, d) in self.list.iter().zip(&mut self.stick) {
+            let k = 2.0 * c.friction * c.lambda / self.smoothing;
+            let damped = c.dashpot && !c.rolls() && k > 0.0;
+            d.ratio = if damped {
+                2.0 * (c.mass.min(1e12) / k).sqrt() / self.beta
+            } else {
+                0.0
+            };
+        }
+    }
+
+    /// Contact `i`'s damped slip at slip `slip`, and 1 + d (its energy's divisor and its
+    /// stiffness's factor).
+    pub(super) fn damped_slip(&self, i: usize, slip: DVec3) -> (DVec3, f64) {
+        match self.stick.get(i) {
+            // (Both slips lie in the contact's plane already.)
+            Some(d) if d.ratio > 0.0 => (slip + (slip - d.reference) * d.ratio, 1.0 + d.ratio),
+            _ => (slip, 1.0),
+        }
+    }
+
+    /// Contact `i`'s friction energy at slip `slip`.
+    pub(super) fn friction_energy(&self, i: usize, slip: DVec3) -> f64 {
+        let c = &self.list[i];
+        let (s, factor) = self.damped_slip(i, slip);
+        c.friction * c.lambda * self.smooth(s.length()).0 / factor
+    }
+
+    /// Contact `i`'s friction force on A's point at slip `slip` (the energy's slope).
+    pub(super) fn friction_force(&self, i: usize, slip: DVec3) -> DVec3 {
+        let c = &self.list[i];
+        let (s, _) = self.damped_slip(i, slip);
+        s * (c.friction * c.lambda * self.smooth(s.length()).1)
+    }
+
+    /// The factor 1 + d of contact `i`'s friction stiffness while it sticks.
+    pub(super) fn stick_factor(&self, i: usize) -> f64 {
+        self.stick.get(i).map_or(1.0, |d| 1.0 + d.ratio)
+    }
+}
