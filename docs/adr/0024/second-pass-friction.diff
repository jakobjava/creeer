+//! Sliding contacts that a Newton direction turns back through their anchor (`mod.rs`).
+//!
+//! A sliding contact's friction is Coulomb's μλ along its slip: its exact Hessian has no
+//! stiffness along the slip, so Newton's model takes its force as constant however far the
+//! direction moves it, back past its anchor too, where the true friction turns about and
+//! rises again. A pile's full Newton steps were rejected for this and its line searches cut
+//! them to a tenth, iteration after iteration (G1.8, P1). Where the direction brings a sliding
+//! contact closest to its anchor within the step, its matrix takes the secant μλ/|u| along
+//! the slip: the friction's model along the slip then has its least at the anchor, where the
+//! true one has. Elsewhere the exact Hessian stays (a secant everywhere made a sliding rock's
+//! steps creep, F6).
+
+use super::{Contacts, Side};
+use crate::structure::group::MemberState;
+use creeer_math::glam::{DMat3, DVec3};
+
+impl Contacts {
+    /// Stiffens the matrices of the sliding contacts `direction` takes closest to their
+    /// anchors within the step (`offsets`: each member's start in it); whether any was.
+    pub(super) fn stiffen_reversals(
+        &mut self,
+        states: &[MemberState<'_>],
+        direction: &[DVec3],
+        offsets: &[usize],
+    ) -> bool {
+        let moved = |side: Side, arm: DVec3| match side {
+            Side::Node { member, node, .. } => {
+                let n = states[member].position.len();
+                let at = offsets[member];
+                direction[at + node] + direction[at + n + node].cross(arm)
+            }
+            Side::Fixed(_) => DVec3::ZERO,
+        };
+        let geometry = self.geometry(states);
+        self.reversed.resize(self.list.len(), false);
+        let mut any = false;
+        for i in 0..self.list.len() {
+            let c = self.list[i];
+            let Some(tangent) = c.tangent else { continue };
+            if self.reversed[i] || c.friction * c.lambda <= 0.0 || self.carried(i).is_some() {
+                continue;
+            }
+            let (_, _, _, slip, arm_a, arm_b) = geometry.at[i];
+            let r = slip.length();
+            if r < self.smoothing {
+                continue;
+            }
+            let relative = moved(c.a, arm_a) - moved(c.b, arm_b);
+            let change = relative - c.normal * c.normal.dot(relative);
+            // Back along the slip past the anchor: there the constant force is wrong.
+            if -slip.dot(change) > r * r {
+                let along = slip / r;
+                let outer = DMat3::from_cols(along * along.x, along * along.y, along * along.z);
+                self.list[i].tangent = Some(tangent + outer * (c.friction * c.lambda / r));
+                self.reversed[i] = true;
+                any = true;
+            }
+        }
+        if any {
+            self.rigid = self.rigid_blocks();
+        }
+        any
+    }
+}
