+++ b/crates/creeer_physics/src/structure/tree.rs
@@ -0,0 +1,233 @@
+//! A group's joint tree stepped in its own coordinates (P1, ADR-0024; RedMax's hybrid,
+//! adapted): its root's translation and turn, and each tree joint's turn (a hinge's one, a
+//! ball's three, in the child's node frame). The bodies stay rigid bodies with their own
+//! poses; the tree only chooses how the minimisation moves them.
+//!
+//! - **The direction** is L-BFGS's on (Jᵀ·H·J)·δq = Jᵀ·r (`tree/solve.rs`): H the group's
+//!   matrix as the rigid bodies' joint solve has it (their own 6×6 blocks, their couplings),
+//!   r the residual, J the tree's Jacobian (each body's twist from its own coordinates and
+//!   its ancestors'). Members not in the tree keep their six.
+//! - **A trial** places the tree's bodies by forward kinematics, parents first: a child's
+//!   orientation is its parent's times the joint's relative orientation turned by the child's
+//!   coordinates; its centre hangs from the joint's point on the parent. The tree's joints
+//!   hold exactly at every trial, so their constraints' terms vanish.
+//! - **The joints' forces**, which no multiplier carries now, come from the converged
+//!   residual: each body's unbalanced force and torque is what its joints hold it with,
+//!   summed from the leaves in.
+//!
+//! The twist convention is the solver's: a node's turn is world-frame, q' = exp(θ)·q.
+
+mod forces;
+mod solve;
+
+use super::coupling::{Coupling, TreeLink, TreeTurn};
+use super::lbfgs::Lbfgs;
+use super::group::{Member, states};
+use crate::so3;
+use creeer_math::glam::{DQuat, DVec3};
+
+/// The tree of a group, for one minimisation.
+#[derive(Debug)]
+pub(super) struct Tree {
+    /// Each member's link to its parent, if it is a tree joint's child.
+    link: Vec<Option<TreeLink>>,
+    /// The members, parents before children (the roots and free members first, then the
+    /// links' children in the coupling's order).
+    order: Vec<usize>,
+    /// Each member's own coordinates: their first index and count.
+    own: Vec<(usize, usize)>,
+    /// The coordinates in all.
+    n: usize,
+    /// The last direction, in the tree's coordinates.
+    dq: Vec<f64>,
+    /// The members of each part rooted at a free body (not the world).
+    parts: Vec<Vec<usize>>,
+    /// L-BFGS in the tree's coordinates (`tree/solve.rs`), the last step taken and the
+    /// reduced residual where it began.
+    lbfgs: Lbfgs,
+    step: Option<Vec<f64>>,
+    last: Option<Vec<f64>>,
+}
+
+/// A member's twist's response to each coordinate it depends on: (coordinate, translation,
+/// turn).
+type Columns = Vec<(usize, DVec3, DVec3)>;
+
+impl Tree {
+    /// The tree of a group of rigid bodies alone, every axis free, if its coupling finds one
+    /// (`Coupling::tree`); its joints closed exactly where the minimisation starts (they held
+    /// within the augmented Lagrangian's micrometre, or rounding, before).
+    pub(super) fn begin(members: &mut [Member<'_>], coupling: &mut dyn Coupling) -> Option<Self> {
+        if !members.iter().all(|(s, _)| s.free_rigid()) || std::env::var_os("CREEER_NO_TREE").is_some() {
+            return None;
+        }
+        let links = coupling.tree(&states(members));
+        let tree = Self::new(&links, members.len())?;
+        tree.close(members);
+        Some(tree)
+    }
+
+    /// The tree of `links` (parents before children) among `members` (`None` if there is none).
+    fn new(links: &[TreeLink], members: usize) -> Option<Self> {
+        if links.is_empty() {
+            return None;
+        }
+        let mut link = vec![None; members];
+        for l in links {
+            link[l.child] = Some(*l);
+        }
+        let mut order: Vec<usize> = (0..members).filter(|&m| link[m].is_none()).collect();
+        order.extend(links.iter().map(|l| l.child));
+        let mut own = vec![(0, 0); members];
+        let mut n = 0;
+        for &m in &order {
+            let count = match link[m].map(|l| l.turn) {
+                None => 6,
+                Some(TreeTurn::Axis(..)) => 1,
+                Some(TreeTurn::Free) => 3,
+            };
+            own[m] = (n, count);
+            n += count;
+        }
+        // Each member's root: itself, its parent's, or none (the world).
+        let mut root: Vec<Option<usize>> = (0..members).map(Some).collect();
+        for l in links {
+            root[l.child] = l.parent.and_then(|p| root[p]);
+        }
+        let parts = (0..members)
+            .filter(|&r| link[r].is_none())
+            .map(|r| (0..members).filter(|&k| root[k] == Some(r)).collect::<Vec<_>>())
+            .filter(|part| part.len() > 1)
+            .collect();
+        Some(Self {
+            link,
+            order,
+            own,
+            n,
+            dq: vec![0.0; n],
+            parts,
+            lbfgs: Lbfgs::default(),
+            step: None,
+            last: None,
+        })
+    }
+
+    /// The parent's pose, or the world's.
+    fn parent(members: &[Member<'_>], l: &TreeLink) -> (DVec3, DQuat) {
+        l.parent.map_or((DVec3::ZERO, DQuat::IDENTITY), |p| {
+            (members[p].0.position[0], members[p].0.orientation[0])
+        })
+    }
+
+    /// Moves each child, parents first, so that its joint holds exactly: its axis turned onto
+    /// its parent's (a hinge), its point onto its parent's.
+    fn close(&self, members: &mut [Member<'_>]) {
+        for &m in &self.order {
+            let Some(l) = self.link[m] else { continue };
+            let (xp, qp) = Self::parent(members, &l);
+            let mut q = members[m].0.orientation[0];
+            if let TreeTurn::Axis(child, parent) = l.turn {
+                let arc = DQuat::from_rotation_arc(q * child, qp * parent);
+                q = (arc * q).normalize();
+            }
+            members[m].0.orientation[0] = q;
+            members[m].0.position[0] = xp + qp * l.at_parent - q * l.at_child;
+        }
+    }
+
+    /// Each member's columns at its present pose.
+    fn columns(&self, members: &[Member<'_>]) -> Vec<Columns> {
+        let mut cols: Vec<Columns> = vec![Vec::new(); members.len()];
+        for &m in &self.order {
+            let (x, q) = (members[m].0.position[0], members[m].0.orientation[0]);
+            let (first, count) = self.own[m];
+            let Some(l) = self.link[m] else {
+                // Free: its own translation and turn.
+                cols[m] = (0..6)
+                    .map(|k| {
+                        let e = DVec3::AXES[k % 3];
+                        if k < 3 {
+                            (first + k, e, DVec3::ZERO)
+                        } else {
+                            (first + k, DVec3::ZERO, e)
+                        }
+                    })
+                    .collect();
+                continue;
+            };
+            // The joint's point, and the parent's columns carried to it.
+            let (xp, qp) = Self::parent(members, &l);
+            let point = xp + qp * l.at_parent;
+            let mut c: Columns = match l.parent {
+                Some(p) => (cols[p].iter())
+                    .map(|&(k, t, w)| (k, t + w.cross(point - xp), w))
+                    .collect(),
+                None => Vec::new(),
+            };
+            // Its own turns, and every column's turn swinging its centre about the point.
+            let axes: Vec<DVec3> = match l.turn {
+                TreeTurn::Axis(a, _) => vec![q * a],
+                // (A ball's about the world's axes: about the child's own, which turn with it, the
+                // gradients L-BFGS compares were in different bases from one iteration to the next,
+                // and under an impact's torques it asked a hand to turn 40 rad.)
+                TreeTurn::Free => DVec3::AXES.to_vec(),
+            };
+            debug_assert_eq!(axes.len(), count);
+            c.extend(axes.iter().enumerate().map(|(i, &a)| (first + i, DVec3::ZERO, a)));
+            let lever = x - point;
+            for col in &mut c {
+                col.1 += col.2.cross(lever);
+            }
+            cols[m] = c;
+        }
+        cols
+    }
+
+    /// Places the tree's children at the trial `alpha` along the last direction, parents
+    /// first, by forward kinematics (the free members keep the trial `set_trial` gave them).
+    pub(super) fn place(&self, members: &mut [Member<'_>], alpha: f64) {
+        for &m in &self.order {
+            let Some(l) = self.link[m] else { continue };
+            let (first, _) = self.own[m];
+            // Its own turn, in the world (as its columns have it).
+            let q = members[m].0.orientation[0];
+            let turn = match l.turn {
+                TreeTurn::Axis(a, _) => q * a * (alpha * self.dq[first]),
+                TreeTurn::Free => {
+                    let d = &self.dq[first..first + 3];
+                    DVec3::new(d[0], d[1], d[2]) * alpha
+                }
+            };
+            // Now (the iterate) and at the trial, the parent's pose.
+            let (parent_now, parent_trial) = match l.parent {
+                Some(p) => (
+                    members[p].0.orientation[0],
+                    (members[p].1.work.trial_x[0], members[p].1.work.trial_q[0]),
+                ),
+                None => (DQuat::IDENTITY, (DVec3::ZERO, DQuat::IDENTITY)),
+            };
+            let q_trial = (parent_trial.1 * parent_now.conjugate() * so3::exp(turn) * q).normalize();
+            let x_trial = parent_trial.0 + parent_trial.1 * l.at_parent - q_trial * l.at_child;
+            let w = &mut members[m].1.work;
+            (w.trial_x[0], w.trial_q[0]) = (x_trial, q_trial);
+        }
+        // A free part's centre of mass moves as the direction has it, linearly (a centroidal
+        // floating base): its momentum then balances as the bodies' own coordinates balance it,
+        // exactly, where the curves of the forward kinematics put it off by their second order
+        // (3·10⁻⁹ of a tumbling pair's momentum over 2 s).
+        for part in &self.parts {
+            let (mut mass, mut off) = (0.0, DVec3::ZERO);
+            for &k in part {
+                let (s, v) = &members[k];
+                let linear = s.position[0] + v.work.direction[0] * alpha;
+                mass += s.mass[0];
+                off += (linear - v.work.trial_x[0]) * s.mass[0];
+            }
+            for &k in part {
+                members[k].1.work.trial_x[0] += off / mass;
+            }
+        }
+    }
+
+}
+
diff --git a/crates/creeer_physics/src/structure/tree/forces.rs b/crates/creeer_physics/src/structure/tree/forces.rs
new file mode 100644
index 0000000..d001bd4
--- /dev/null
+++ b/crates/creeer_physics/src/structure/tree/forces.rs
@@ -0,0 +1,74 @@
+//! A joint tree's joints' forces, from the residual where the minimisation ends (`tree.rs`).
+
+use super::super::group::Member;
+use super::super::coupling::TreeTurn;
+use super::Tree;
+use creeer_math::glam::DVec3;
+
+impl Tree {
+    /// Each tree joint's force and torque from its parent on its child, about its point and
+    /// across its free turns, in the links' order: what holds each body against its residual
+    /// `all` (−β²·∇G, `b2` = β²) and its children's joints, the leaves first.
+    pub(in crate::structure) fn forces(
+        &self,
+        members: &[Member<'_>],
+        all: &[DVec3],
+        offsets: &[usize],
+        b2: f64,
+    ) -> Vec<(DVec3, DVec3)> {
+        // What each body's children hold it with (force, torque about its centre), and
+        // each child's joint's force and torque.
+        let mut from_children = vec![(DVec3::ZERO, DVec3::ZERO); members.len()];
+        let mut joint = vec![(DVec3::ZERO, DVec3::ZERO); members.len()];
+        for &m in self.order.iter().rev() {
+            let Some(l) = self.link[m] else { continue };
+            let (x, q) = (members[m].0.position[0], members[m].0.orientation[0]);
+            let (xp, qp) = Self::parent(members, &l);
+            let point = xp + qp * l.at_parent;
+            // The body balanced: its own unbalanced force, its children's, its joint's.
+            let (force, torque) = (all[offsets[m]] / b2, all[offsets[m] + 1] / b2);
+            let f = -(force + from_children[m].0);
+            let tau = -(torque + from_children[m].1) - (point - x).cross(f);
+            if let Some(p) = l.parent {
+                from_children[p].0 -= f;
+                from_children[p].1 -= tau + (point - xp).cross(f);
+            }
+            // (Along its free turns the converged residual leaves only rounding.)
+            joint[m] = match l.turn {
+                TreeTurn::Axis(a, _) => {
+                    let u = (q * a).normalize();
+                    (f, tau - u * u.dot(tau))
+                }
+                TreeTurn::Free => (f, DVec3::ZERO),
+            };
+        }
+        (self.order.iter())
+            .filter(|&&m| self.link[m].is_some())
+            .map(|&m| joint[m])
+            .collect()
+    }
+
+    /// Each member's force and torque (about its centre) from `per_link`, each tree joint's
+    /// force and torque (about its point) from its parent on its child, in the links' order.
+    pub(in crate::structure) fn spread(
+        &self,
+        members: &[Member<'_>],
+        per_link: &[(DVec3, DVec3)],
+    ) -> Vec<(DVec3, DVec3)> {
+        let mut on = vec![(DVec3::ZERO, DVec3::ZERO); members.len()];
+        let children = self.order.iter().filter(|&&m| self.link[m].is_some());
+        for (&m, &(f, tau)) in children.zip(per_link) {
+            let Some(l) = self.link[m] else { continue };
+            let (xp, qp) = Self::parent(members, &l);
+            let point = xp + qp * l.at_parent;
+            let x = members[m].0.position[0];
+            on[m].0 += f;
+            on[m].1 += tau + (point - x).cross(f);
+            if let Some(p) = l.parent {
+                on[p].0 -= f;
+                on[p].1 -= tau + (point - xp).cross(f);
+            }
+        }
+        on
+    }
+}
diff --git a/crates/creeer_physics/src/structure/tree/solve.rs b/crates/creeer_physics/src/structure/tree/solve.rs
new file mode 100644
index 0000000..28b2245
--- /dev/null
+++ b/crates/creeer_physics/src/structure/tree/solve.rs
@@ -0,0 +1,166 @@
+//! A joint tree's Newton direction (`tree.rs`): its reduced matrix Jᵀ·H·J, factorised, as the
+//! base of L-BFGS in the tree's coordinates (as the bodies' own coordinates take the joint
+//! solve, `lbfgs.rs`).
+//!
+//! The reduced matrix is Gauss–Newton's: it leaves out the curvature of the forward kinematics,
+//! the joints' turns swinging their children's points, under the forces the step balances
+//! (RedMax's geometric stiffness). Under a ragdoll's weight and its contacts that curvature
+//! was most of the objective's: Newton with the matrix alone took 500 iterations of steps cut
+//! to a three-hundredth, in a step the bodies' own coordinates took in 30. L-BFGS learns it
+//! from the steps it takes, in the tree's coordinates (their gradients Jᵀ·r, each at its pose).
+
+use super::super::coupling::NodeCoupling;
+use super::super::group::Member;
+use super::Tree;
+use creeer_math::glam::DVec3;
+
+/// v·M for a 6×6 block over (translation, turn), as two vectors.
+fn apply(m6: &[[f64; 6]; 6], t: DVec3, w: DVec3) -> (DVec3, DVec3) {
+    let v = [t.x, t.y, t.z, w.x, w.y, w.z];
+    let row = |r: usize| (0..6).map(|c| m6[r][c] * v[c]).sum::<f64>();
+    (
+        DVec3::new(row(0), row(1), row(2)),
+        DVec3::new(row(3), row(4), row(5)),
+    )
+}
+
+/// The tree's coordinates as vectors of three (the last padded), for L-BFGS.
+fn pack(v: &[f64]) -> Vec<DVec3> {
+    v.chunks(3)
+        .map(|c| DVec3::new(c[0], *c.get(1).unwrap_or(&0.0), *c.get(2).unwrap_or(&0.0)))
+        .collect()
+}
+
+fn unpack(v: &[DVec3], n: usize) -> Vec<f64> {
+    v.iter().flat_map(|d| d.to_array()).take(n).collect()
+}
+
+impl Tree {
+    /// The direction for the residual `all` (member m's translation at `offsets[m]`, its turn
+    /// after), solved in the tree's coordinates with the rigid members' own matrices `rigid`
+    /// and their couplings `cross` (scaled by `b2`, as the joint solve scales them); written
+    /// back into `all`. Should the couplings leave the reduced matrix not positive definite,
+    /// the members' own matrices alone give it (they are: inertia and Gauss–Newton terms).
+    pub(in crate::structure) fn solve(
+        &mut self,
+        all: &mut [DVec3],
+        members: &[Member<'_>],
+        (rigid, cross, b2): (&[Option<[[f64; 6]; 6]>], &[NodeCoupling], f64),
+        offsets: &[usize],
+    ) {
+        let cols = self.columns(members);
+        let n = self.n;
+        let mut g = vec![0.0; n];
+        let mut h = vec![0.0; n * n];
+        for (m, c) in cols.iter().enumerate() {
+            let (rt, rw) = (all[offsets[m]], all[offsets[m] + 1]);
+            for &(k, t, w) in c {
+                g[k] += t.dot(rt) + w.dot(rw);
+            }
+            let own = rigid[m].as_ref().expect("a tree's members are rigid bodies");
+            for &(l, tl, wl) in c {
+                let (ht, hw) = apply(own, tl, wl);
+                for &(k, tk, wk) in c {
+                    h[k * n + l] += tk.dot(ht) + wk.dot(hw);
+                }
+            }
+        }
+        let mut own = h.clone();
+        for &((a, na), (b, nb), m6) in cross {
+            if a == b || na != 0 || nb != 0 {
+                continue;
+            }
+            for &(l, tl, wl) in &cols[b] {
+                let (ht, hw) = apply(&m6, tl, wl);
+                for &(k, tk, wk) in &cols[a] {
+                    let v = (tk.dot(ht) + wk.dot(hw)) * b2;
+                    h[k * n + l] += v;
+                    h[l * n + k] += v;
+                }
+            }
+        }
+        let factor = if cholesky(&mut h, n) {
+            h
+        } else {
+            let factored = cholesky(&mut own, n);
+            debug_assert!(factored, "a tree's own matrix is positive definite");
+            own
+        };
+        // The last step's pair: its step, and how the gradient changed over it.
+        if let (Some(step), Some(last)) = (self.step.take(), self.last.take()) {
+            let change: Vec<f64> = last.iter().zip(&g).map(|(a, b)| a - b).collect();
+            self.lbfgs.push(pack(&step), pack(&change));
+        }
+        let mut packed = pack(&g);
+        self.last = Some(g);
+        self.lbfgs.direction(&mut packed, |v| {
+            let mut x = unpack(v, n);
+            substitute(&factor, n, &mut x);
+            v.copy_from_slice(&pack(&x));
+        });
+        let dq = unpack(&packed, n);
+        for (m, c) in cols.iter().enumerate() {
+            let (mut t, mut w) = (DVec3::ZERO, DVec3::ZERO);
+            for &(k, tk, wk) in c {
+                t += tk * dq[k];
+                w += wk * dq[k];
+            }
+            all[offsets[m]] = t;
+            all[offsets[m] + 1] = w;
+        }
+        self.dq = dq;
+    }
+
+    /// The line search took `alpha` of the last direction.
+    pub(in crate::structure) fn accepted(&mut self, alpha: f64) {
+        self.step = Some(self.dq.iter().map(|d| d * alpha).collect());
+    }
+
+    /// Forgets the steps taken (the objective changed under them: lagged quantities refreshed).
+    pub(in crate::structure) fn forget(&mut self) {
+        self.lbfgs.clear();
+        (self.step, self.last) = (None, None);
+    }
+}
+
+/// Factorises `h` (n×n, symmetric positive definite) in place as L·Lᵀ, L in its lower
+/// triangle. False if a pivot is not positive.
+fn cholesky(h: &mut [f64], n: usize) -> bool {
+    for j in 0..n {
+        let mut d = h[j * n + j];
+        for k in 0..j {
+            d -= h[j * n + k] * h[j * n + k];
+        }
+        if !(d > 0.0) {
+            return false;
+        }
+        let d = d.sqrt();
+        h[j * n + j] = d;
+        for i in j + 1..n {
+            let mut v = h[i * n + j];
+            for k in 0..j {
+                v -= h[i * n + k] * h[j * n + k];
+            }
+            h[i * n + j] = v / d;
+        }
+    }
+    true
+}
+
+/// Solves L·Lᵀ·x = g in place with the factor of [`cholesky`].
+fn substitute(l: &[f64], n: usize, g: &mut [f64]) {
+    for i in 0..n {
+        let mut v = g[i];
+        for k in 0..i {
+            v -= l[i * n + k] * g[k];
+        }
+        g[i] = v / l[i * n + i];
+    }
+    for i in (0..n).rev() {
+        let mut v = g[i];
+        for k in i + 1..n {
+            v -= l[k * n + i] * g[k];
+        }
+        g[i] = v / l[i * n + i];
+    }
+}
