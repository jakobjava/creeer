+//! A group's joints as a tree (P1, ADR-0024; `structure/tree.rs` steps in it): a spanning
+//! forest of the joints between rigid bodies, rooted at the world where a joint holds a body
+//! to it, else at each part's heaviest body. Its joints are held exactly by the step's own
+//! coordinates; the joints that would close a loop stay augmented Lagrangian, as all joints
+//! were (RedMax's hybrid). Limits, damping, friction and drives stay energy terms of every
+//! joint.
+
+use super::Kind;
+use super::group::Joints;
+use crate::structure::group::{MemberState, TreeLink, TreeTurn};
+use creeer_math::glam::DVec3;
+use std::collections::VecDeque;
+
+/// Grows the tree from `root` over the joints not yet `seen`: (child, joint) of each joint
+/// taken, parents before children.
+fn grow(root: usize, edges: &[Vec<(usize, usize)>], seen: &mut [bool], out: &mut Vec<(usize, usize)>) {
+    seen[root] = true;
+    let mut queue = VecDeque::from([root]);
+    while let Some(node) = queue.pop_front() {
+        for &(next, j) in &edges[node] {
+            if !seen[next] {
+                seen[next] = true;
+                out.push((next, j));
+                queue.push_back(next);
+            }
+        }
+    }
+}
+
+impl Joints {
+    /// The tree of the group's joints among `states.len()` members, parents before children;
+    /// its joints held from now until the step's next [`Joints::begin`].
+    pub(crate) fn tree_links(&mut self, states: &[MemberState<'_>]) -> Vec<TreeLink> {
+        let members = states.len();
+        let world = members;
+        // Each node's joints to others (the world the last node): rigid bodies' alone.
+        let mut edges: Vec<Vec<(usize, usize)>> = vec![Vec::new(); members + 1];
+        let mut mass = vec![0.0_f64; members];
+        for (j, (_, joint)) in self.list.iter().enumerate() {
+            let [(ma, _, rigid_a), (mb, _, rigid_b)] = self.sides[j];
+            let (a, b) = (joint.a.0, joint.b.map_or(world, |b| b.0));
+            if !rigid_a || (joint.b.is_some() && !rigid_b) || a == b {
+                continue;
+            }
+            mass[a] = ma;
+            if b < members {
+                mass[b] = mb;
+            }
+            edges[a].push((b, j));
+            edges[b].push((a, j));
+        }
+        // From the world first, then each part left from its heaviest body (the root's six
+        // coordinates on the body most of the part's inertia is in).
+        let mut seen = vec![false; members + 1];
+        let mut taken = Vec::new();
+        if !edges[world].is_empty() {
+            grow(world, &edges, &mut seen, &mut taken);
+        }
+        for m in 0..members {
+            if seen[m] || edges[m].is_empty() {
+                continue;
+            }
+            let mut part = Vec::new();
+            grow(m, &edges, &mut seen.clone(), &mut part);
+            let root = (part.iter().map(|p| p.0))
+                .fold(m, |best, n| if mass[n] > mass[best] { n } else { best });
+            grow(root, &edges, &mut seen, &mut taken);
+        }
+        self.held = vec![false; self.list.len()];
+        self.tree = Vec::with_capacity(taken.len());
+        let links: Vec<TreeLink> = (taken.iter())
+            .map(|&(child, j)| {
+                let joint = &self.list[j].1;
+                self.held[j] = true;
+                let child_a = joint.a.0 == child;
+                self.tree.push((j, child_a));
+                let (at_child, at_parent, frame_child, frame_parent, parent) = if child_a {
+                    let parent = joint.b.map(|b| b.0);
+                    (joint.at_a, joint.at_b, joint.frame_a, joint.frame_b, parent)
+                } else {
+                    let parent = Some(joint.a.0);
+                    (joint.at_b, joint.at_a, joint.frame_b, joint.frame_a, parent)
+                };
+                let turn = match joint.kind {
+                    Kind::Hinge { .. } => {
+                        TreeTurn::Axis(frame_child * DVec3::X, frame_parent * DVec3::X)
+                    }
+                    Kind::Ball { .. } => TreeTurn::Free,
+                };
+                TreeLink {
+                    child,
+                    parent,
+                    at_parent,
+                    at_child,
+                    turn,
+                }
+            })
+            .collect();
+        if !links.is_empty() {
+            self.make_blocks(states);
+        }
+        links
+    }
+
+    /// Forgets what the joints not held this substep carried in a tree: their accelerations
+    /// carry their end's force (called after every substep).
+    pub(super) fn forget_carried(&mut self) {
+        for (j, (_, joint)) in self.list.iter_mut().enumerate() {
+            if !self.held.get(j).copied().unwrap_or(false) {
+                joint.multipliers.carried = None;
+            }
+        }
+    }
+
+    /// The tree joints' constraint forces (`Coupling::tree_forces`): over the step, kept as
+    /// their multipliers (as a joint not held keeps them), and what the trapezoid carries into
+    /// the next, which it returns. A trapezoid's step holds the mean of what it carried in and
+    /// its end; carrying the end on, that mean's error rang, twice and none on alternate
+    /// steps, undamped (the trapezoid on exact constraints, Cardona and Géradin 1989).
+    /// Carried is the force at the step's end as the means find it, the last one taken on
+    /// half a step: (3·mₙ − mₙ₋₁)/2, second order like the trapezoid, and not ringing. (The
+    /// mean itself, carried, was half a step late: a double pendulum's angles fell behind.)
+    pub(crate) fn tree_forces(&mut self, end: &[(DVec3, DVec3)], mean: bool) -> Vec<(DVec3, DVec3)> {
+        let mut taken = Vec::with_capacity(end.len());
+        for (&(j, child_a), &(force, torque)) in self.tree.iter().zip(end) {
+            // The multipliers are B's pull on A, negated (`Joint::force`), and the torque B
+            // holds A's axis with: the parent's on the child, signed by which side it is.
+            let m = &mut self.list[j].1.multipliers;
+            let sign = if child_a { -1.0 } else { 1.0 };
+            let ours = |(f, t): (DVec3, DVec3)| (f * sign, t * -sign);
+            let last = ours((m.point, m.axis));
+            // (Before a tree held it, its accelerations carried its last end's force.)
+            let carried = m.carried.map_or(last, ours);
+            let (over, on) = if mean {
+                let over = ((carried.0 + force) * 0.5, (carried.1 + torque) * 0.5);
+                let on = ((over.0 * 3.0 - last.0) * 0.5, (over.1 * 3.0 - last.1) * 0.5);
+                (over, on)
+            } else {
+                ((force, torque), (force, torque))
+            };
+            (m.point, m.axis) = ours(over);
+            m.carried = Some(ours(on));
+            taken.push(on);
+        }
+        taken
+    }
+}
