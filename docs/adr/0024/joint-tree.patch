+//! The shapes of the joints' energy terms (`group.rs`): friction's smoothing, a one-sided
+//! constraint's augmented Lagrangian, a drive's Huber springs, and the Gauss–Newton outer
+//! products.
+
+use super::ARM;
+use super::group::STICK;
+use super::rows::{Row, Scalar};
+use creeer_math::glam::{DMat3, DVec3};
+
+/// f₀ and f₀'/x of the friction's smoothing (the contacts' cubic).
+pub(super) fn smooth(x: f64) -> (f64, f64) {
+    let e = STICK;
+    if x >= e {
+        (x, 1.0 / x)
+    } else {
+        (
+            -x * x * x / (3.0 * e * e) + x * x / e + e / 3.0,
+            2.0 / e - x / (e * e),
+        )
+    }
+}
+
+/// The energy of a one-sided constraint `g ≤ 0` with multiplier `lambda` and penalty `k`
+/// (augmented Lagrangian), and its derivative.
+pub(super) fn one_sided(g: f64, lambda: f64, k: f64) -> (f64, f64) {
+    let f = (lambda + k * g).max(0.0);
+    ((f * f - lambda * lambda) / (2.0 * k), f)
+}
+
+/// A drive's energy: a Huber spring on each arm (k·r up to the strength's share, constant
+/// beyond), telling `each` every scalar's coefficient and weight.
+pub(super) fn drive_energy(
+    drive: super::Drive,
+    arms: &[[Scalar; 3]; 3],
+    mut each: impl FnMut(&Scalar, (f64, f64)),
+) -> f64 {
+    let k = drive.stiffness / (2.0 * ARM * ARM);
+    let most = drive.strength / (2.0 * ARM);
+    let mut total = 0.0;
+    for arm in arms {
+        let r = arm.iter().map(|s| s.value * s.value).sum::<f64>().sqrt();
+        let (energy, per) = if k * r <= most {
+            (0.5 * k * r * r, k)
+        } else {
+            (most * r - 0.5 * most * most / k, most / r)
+        };
+        total += energy;
+        for s in arm {
+            each(s, (per * s.value, per));
+        }
+    }
+    total
+}
+
+/// Adds w·u·vᵀ, skipping the rows' zeros (a gap's row is three of six: its axis, and its
+/// turn across the axis).
+pub(super) fn outer(m6: &mut [[f64; 6]; 6], u: &Row, v: &Row, w: f64) {
+    for (row, &ur) in m6.iter_mut().zip(u) {
+        if ur == 0.0 {
+            continue;
+        }
+        let wu = w * ur;
+        for (x, &vc) in row.iter_mut().zip(v) {
+            if vc != 0.0 {
+                *x += wu * vc;
+            }
+        }
+    }
+}
+
+pub(super) fn translation(u: &Row, w: f64) -> DMat3 {
+    let t = DVec3::new(u[0], u[1], u[2]);
+    DMat3::from_cols(t * t.x, t * t.y, t * t.z) * w
+}
+
