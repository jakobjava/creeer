+#[test]
+#[ignore = "A/B: the multipliers' refresh on identical states"]
+fn ab_lag() {
+    let mut world = World::new(DT);
+    world.statics.push(StaticShape::Plane {
+        normal: DVec3::Y,
+        offset: 0.0,
+    });
+    let mut b = character::body(DVec3::new(0.0, 0.02, 0.0), DVec3::Y, DT);
+    b.structure.angular_velocity[0] = DVec3::new(1.5, 0.0, 0.3);
+    let c = world.add(b);
+    fall(&mut world, c);
+    creeer_physics::profile::PLAIN_LAG.store(true, std::sync::atomic::Ordering::Relaxed);
+    let mut snapshots = Vec::new();
+    for _ in 0..240 {
+        snapshots.push(world.to_bytes());
+        world.step();
+    }
+    let gap = |w: &World| {
+        (w.joints().iter())
+            .map(|j| {
+                let p = |(b, n): (usize, usize), l: DVec3| {
+                    let s = &w.bodies[b].structure;
+                    s.position[n] + s.orientation[n] * l
+                };
+                (p(j.a, j.at_a) - p(j.b.unwrap(), j.at_b)).length()
+            })
+            .fold(0.0, f64::max)
+    };
+    eprintln!("reference end gap {:.2e}", gap(&world));
+    let back = World::from_bytes(&snapshots[100]).unwrap();
+    eprintln!("read back: gap {:.2e}, bodies {}, joints {}, statics {}", gap(&back), back.bodies.len(), back.joints().len(), back.statics.len());
+    let mut ends: Vec<Vec<Vec<DVec3>>> = Vec::new();
+    for plain in [true, false] {
+        creeer_physics::profile::PLAIN_LAG.store(plain, std::sync::atomic::Ordering::Relaxed);
+        let (mut its, mut total, mut worst, mut worst_gap) = (0u64, 0.0, 0.0f64, 0.0f64);
+        let mut end = Vec::new();
+        let _ = creeer_physics::profile::take();
+        for (index, bytes) in snapshots.iter().enumerate() {
+            if let Some(only) = std::env::var("ONLY").ok().and_then(|s| s.parse::<usize>().ok()) {
+                if index != only {
+                    end.push(Vec::new());
+                    continue;
+                }
+            }
+            let mut w = World::from_bytes(bytes).unwrap();
+            let before: u64 = w.bodies.iter().map(|b| b.solver.iterations_total).sum();
+            let t = std::time::Instant::now();
+            w.step();
+            let ms = t.elapsed().as_secs_f64() * 1e3;
+            its += w.bodies.iter().map(|b| b.solver.iterations_total).sum::<u64>() - before;
+            total += ms;
+            worst = worst.max(ms);
+            worst_gap = worst_gap.max(gap(&w));
+            if !plain && gap(&w) > 1e-2 && std::env::var_os("FIRST_BAD").is_some() {
+                eprintln!("first bad snapshot: {}", end.len());
+                std::process::exit(0);
+            }
+            end.push(w.bodies.iter().map(|b| b.structure.position[0]).collect());
+        }
+        let spent = creeer_physics::profile::take();
+        let names = creeer_physics::profile::NAMES;
+        let slot = |name: &str| names.iter().find(|n| n.1 == name).map_or(0, |n| spent[n.0 as usize]);
+        eprintln!("  group steps {} iterations {} lag updates {} lag iterations {} trials {}", slot("group steps"), slot("iterations"), slot("lag updates"), slot("lag iterations"), slot("trials"));
+        eprintln!("plain {plain}: {:.1} ms total, worst {worst:.2} ms, {} its/body, worst gap {worst_gap:.2e} m", total, its / 15);
+        ends.push(end);
+    }
+    let off = (ends[0].iter().zip(&ends[1]))
+        .flat_map(|(a, b)| a.iter().zip(b).map(|(p, q)| (*p - *q).length()))
+        .fold(0.0, f64::max);
+    eprintln!("largest difference of a segment's end position: {off:.2e} m");
