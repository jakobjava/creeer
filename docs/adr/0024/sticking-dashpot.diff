+impl Contacts {
+    /// Sets each sticking contact's dashpot on its slip for the step (`start`, `previous`: the
+    /// members at the step's start and the one before, `ahead` = τ/h).
+    ///
+    /// Static friction is the anchor's stiff spring (`mod.rs`), elastic: two logs lying across
+    /// each other on the ground, each sticking where it touches the other and the ground, rocked
+    /// on those springs at 3 Hz for good, their energy constant to 10⁻⁷ J (G2.0). Real contacts
+    /// that stick dissipate as they are loaded to and fro (Mindlin's microslip, Johnson §7.4),
+    /// and a contact model that sticks with a spring damps it, as discrete element models do
+    /// (Cundall & Strack 1979; Tsuji et al. 1992). So the spring is damped critically, as the
+    /// normal dashpot damps the penetration: c = 2·√(k·m), k = 2·μ·λ/e the stick spring's
+    /// stiffness at rest. Only while it sticks at the step's start: sliding, friction is
+    /// Coulomb's alone. Not for contacts with spheres (their friction points are carried).
+    pub(super) fn start_slip_dashpots(
+        &mut self,
+        start: &[MemberState<'_>],
+        previous: &[MemberState<'_>],
+        ahead: f64,
+    ) {
+        self.slip_references.clear();
+        for i in 0..self.list.len() {
+            let c = self.list[i];
+            let sticks = c.dashpot && c.friction > 0.0 && c.lambda > 0.0 && !c.rolls();
+            let now = self.gap_and_slip(i, start).3;
+            let then = self.gap_and_slip(i, previous).3;
+            let sticks = sticks && now.length() < 0.5 * self.smoothing && (now - then).length() < RESTING * self.smoothing;
+            let k = 2.0 * c.friction * c.lambda / self.smoothing;
+            self.list[i].sticking = if sticks {
+                2.0 * (k * c.mass.min(1e12)).sqrt()
+            } else {
+                0.0
+            };
+            self.slip_references.push(now + (now - then) * ahead);
+        }
+    }
+
+    /// The sticking dashpot's energy at contact `i`'s slip `slip`, its slope by the slip, and
+    /// its stiffness there (across the slip's rate, along it).
+    ///
+    /// Its force is at most a tenth of Coulomb's μ·λ (beyond, it grows no more: Huber's
+    /// function of the rate): it damps the spring that sticks, and must not hold a body that
+    /// begins to slide. Unbounded, it held a wedge on a 40° ramp (μ = 0.3) at 1 cm/s, where it
+    /// slides 6 m in a second.
+    pub(super) fn slip_dashpot(&self, i: usize, slip: DVec3) -> (f64, DVec3, [f64; 2]) {
+        let contact = &self.list[i];
+        let c = contact.sticking / self.beta;
+        if c == 0.0 {
+            return (0.0, DVec3::ZERO, [0.0; 2]);
+        }
+        let n = contact.normal;
+        let reference = self.slip_references.get(i).copied().unwrap_or(slip);
+        let mut rate = slip - reference;
+        rate -= n * n.dot(rate);
+        let r = rate.length();
+        let most = DAMPED_SHARE * contact.friction * contact.lambda;
+        let reach = most / c;
+        if r <= reach {
+            (0.5 * c * r * r, rate * c, [c, c])
+        } else {
+            (most * (r - 0.5 * reach), rate * (most / r), [most / r, 0.0])
+        }
+    }
+}
