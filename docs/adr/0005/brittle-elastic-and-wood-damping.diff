@@ -0,0 +1,101 @@
+//! Brittle members break where their stress reaches their strength (G2.11; `plastic.rs`'s
+//! module docs; `docs/physics/g2p-validation.md`): ASTM D143's static bending test of a small
+//! clear specimen, on green spruce as the materials table gives it.
+//!
+//! ASTM D143: a 50 × 50 mm bar on a 710 mm span, loaded at its middle until it breaks; its
+//! modulus of rupture is MOR = 3·P·L / (2·b·h²) at the breaking load P, the stress at failure as
+//! if the bar were elastic to the end. The *Wood Handbook*'s tables (FPL-GTR-282, Table 5-3a)
+//! are such tests. A bar of the model must give back the table's MOR it was made from.
+
+use super::section::{Material, Section};
+use super::*;
+use creeer_math::glam::DVec3;
+
+const SPAN: f64 = 0.71;
+const SIDE: f64 = 0.05;
+/// Elements along the bar: its middle a node.
+const PIECES: usize = 8;
+
+fn spruce() -> Material {
+    let table = creeer_materials::MaterialTable::reference();
+    Material::from(table.get("spruce_green").expect("shipped").structural(293.15))
+}
+
+/// The bar loaded at its middle by a load growing at `rate` (N/s), stepped by `h` seconds:
+/// the load it broke at (N), and the largest elastic moment its middle carried in the steps
+/// before (N·m).
+fn bend(rate: f64, h: f64) -> (f64, f64) {
+    let mut b = StructureBuilder::new();
+    let nodes: Vec<NodeId> = (0..=PIECES)
+        .map(|i| b.node(DVec3::X * (SPAN * i as f64 / PIECES as f64)))
+        .collect();
+    // Pinned at one end (not spinning about its axis), on a roller at the other.
+    b.support(
+        nodes[0],
+        Support::Custom {
+            translation: DVec3::ZERO,
+            rotation: DVec3::new(0.0, 1.0, 1.0),
+        },
+    );
+    b.support(
+        nodes[PIECES],
+        Support::Custom {
+            translation: DVec3::X,
+            rotation: DVec3::ONE,
+        },
+    );
+    for k in 0..PIECES {
+        b.beam(nodes[k], nodes[k + 1], Section::rectangle(SIDE, SIDE), spruce());
+    }
+    let mut s = b.build();
+    s.gravity = DVec3::ZERO;
+    let middle = PIECES / 2;
+    let mut solver = ImplicitSolver::new(&s, Scheme::Newmark, h, 1);
+    let mut carried = 0.0f64;
+    for step in 1..=200_000 {
+        let load = rate * h * f64::from(step);
+        s.load[nodes[middle]] = DVec3::NEG_Y * load;
+        solver.step(&mut s);
+        if solver.last_yielding.broke > 0 {
+            return (load, carried);
+        }
+        // The elastic end moments of the two elements at the middle.
+        for e in [&s.elements[middle - 1], &s.elements[middle]] {
+            let r = |n: usize| creeer_math::glam::DMat3::from_quat(s.orientation[n]);
+            let m = e.measures(s.position[e.a], r(e.a), s.position[e.b], r(e.b));
+            let force = e.stiffness.apply(&m);
+            carried = force[2..].iter().fold(carried, |c, f| c.max(f.abs()));
+        }
+    }
+    panic!("never broke");
+}
+
+/// The breaking moment by the table: MOR·b·h²/6.
+fn rupture() -> f64 {
+    spruce().yield_strength * SIDE * SIDE * SIDE / 6.0
+}
+
+#[test]
+fn a_green_spruce_bar_breaks_at_its_modulus_of_rupture() {
+    // Loaded to the table's breaking load in about 10 s, at 60 Hz (the test's own takes
+    // minutes; the bar's first mode is 150 Hz: quasi-static either way).
+    let breaking = 4.0 * rupture() / SPAN;
+    let (load, carried) = bend(breaking / 10.0, 1.0 / 60.0);
+    let mor = 3.0 * load * SPAN / (2.0 * SIDE * SIDE * SIDE);
+    let table = spruce().yield_strength;
+    println!("MOR {:.2} MPa (table {:.2}), carried {carried:.1} of {:.1} N·m", mor / 1e6, table / 1e6, rupture());
+    assert!((mor / table - 1.0).abs() < 0.01, "MOR {mor:.4e} against {table:.4e}");
+    assert!(carried <= rupture() * 1.001, "carried {carried:.1} N·m before breaking");
+}
+
+#[test]
+fn a_bar_struck_breaks_on_its_stress_not_its_damping() {
+    // Loaded to its breaking load in 30 ms (an impact), in 0.5 ms steps as impacts are: its
+    // damping (c = material.damping) is then 60 times its spring's rate. It breaks where the
+    // stress in its fibres reaches the strength, not before.
+    let breaking = 4.0 * rupture() / SPAN;
+    let (load, carried) = bend(breaking / 0.03, 0.5e-3);
+    println!("struck: broke at {load:.0} N, carried {carried:.1} of {:.1} N·m", rupture());
+    assert!(carried >= 0.97 * rupture(), "carried {carried:.1} N·m, breaks at {:.1}", rupture());
+    assert!(carried <= rupture() * 1.001, "carried {carried:.1} N·m before breaking");
+}
