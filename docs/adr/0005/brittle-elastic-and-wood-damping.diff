-        let (my, mz) = (
-            sy * sec.plastic_modulus[0] * room,
-            sy * sec.plastic_modulus[1] * room,
-        );
+        // A brittle member breaks in bending at its elastic section modulus (module docs).
+        let modulus = if self.brittle() {
+            [sec.i_y / sec.extent[1], sec.i_z / sec.extent[0]]
+        } else {
+            sec.plastic_modulus
+        };
+        let (my, mz) = (sy * modulus[0] * room, sy * modulus[1] * room);
         let caps = [n_p, sy / 3f64.sqrt() * sec.plastic_torsion, my, my, mz, mz];
         (caps, force)
     }
 
+    /// Whether the member is brittle (module docs): of a material that breaks without
+    /// elongating, and no joint (a joint's fasteners have their own law, `fastened.rs`).
+    pub(crate) fn brittle(&self) -> bool {
+        !self.is_joint() && self.material.elongation <= 0.0
+    }
