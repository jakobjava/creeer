+/// A new contact's anchor (as found, or kept from the last step), brought to within the stick
+/// distance of A's point `at` across its normal, if it lay farther: its contact was sliding,
+/// and its anchor follows, as after a step (`Contacts::moved_anchor`). An anchor farther holds
+/// friction loaded beyond what sticking holds, which the step lets go as motion: the energy
+/// guard books no friction. A face's corner a hole's depth from the wall it presses on (a
+/// pole's 3 m face, its corner 10 cm out) had its anchor at its foot, 10 cm off along the
+/// normal; the next step's normal, turned 1–2°, put that 2–4 mm across it, and a pole leaning
+/// in a hole rolled about its axis every other step, stopped dead by the guard between (G2.10).
+pub(super) fn within_stick(
+    bodies: &[Body],
+    b: Option<(usize, NodeId)>,
+    contact: &mut Contact,
+    at: DVec3,
+) {
+    let world = |side: Side| match (side, b) {
+        (Side::Node { node, local, .. }, Some((body, _))) => {
+            let s = &bodies[body].structure;
+            Some(s.position[node] + s.orientation[node] * local)
+        }
+        (Side::Fixed(p), _) => Some(p),
+        _ => None,
+    };
+    let Some(anchor) = world(contact.anchor) else {
+        return;
+    };
+    let n = contact.normal;
+    let off = at - anchor;
+    let slip = off - n * n.dot(off);
+    let length = slip.length();
+    if length <= STICK_DISTANCE {
+        return;
+    }
+    let moved = anchor + slip * (1.0 - STICK_DISTANCE / length);
+    contact.anchor = match (contact.anchor, b) {
+        (Side::Node { member, node, .. }, Some((body, _))) => {
+            let s = &bodies[body].structure;
+            Side::Node {
+                member,
+                node,
+                local: s.orientation[node].conjugate() * (moved - s.position[node]),
+            }
+        }
+        _ => Side::Fixed(moved),
+    };
+}
