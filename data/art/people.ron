// The colours each player chooses from (docs/art-style.md §3.3): the `skin` and `hair` tokens'
// choices. A test reads art-style.md's lists and fails if this file differs.
//
// Skin: measured skin (G1.3i, replacing the Monk scale's display swatches, which the user found
// "horribly pale, like plastic"). Ten tones evenly in lightness from L* 70 to 32, the range of
// faces measured by spectrophotometer (Xiao et al. 2017, 960 people: faces L* 56-61 on average,
// 29-73 in all; Wang et al. 2015: African faces about L* 37-43); hue 55° (measured faces 51-60°);
// chroma about 19 in the middle, less towards both ends, as both studies report. CIELAB (D65)
// converted to sRGB, lightest first.
// Hair: measured, not painted. Dark brown to red and blond: Mengel-From et al. (2009),
// spectrophotometry of 107 Scots; black and light brown from a cosmetics journal's samples;
// grey from a natural grey sample. CIELAB (D65) converted to sRGB.
(
    skin: [
        ("1", "#c2a597"),
        ("2", "#ba9a89"),
        ("3", "#b18f7c"),
        ("4", "#a88471"),
        ("5", "#9d7a66"),
        ("6", "#936f5c"),
        ("7", "#896552"),
        ("8", "#7d5c4a"),
        ("9", "#6f5040"),
        ("10", "#604637"),
    ],
    hair: [
        ("black", "#2c2928"),
        ("dark brown", "#3c332d"),
        ("brown", "#4f3f35"),
        ("light brown", "#5f4836"),
        ("dark blond", "#765f49"),
        ("blond", "#90785c"),
        ("auburn", "#5e4031"),
        ("red", "#7b563f"),
        ("grey", "#968a72"),
    ],
)
