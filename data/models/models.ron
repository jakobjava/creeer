// The models (G1.3b, ADR-0026): each made by its script in art/ (docs/blender-mcp.md) and
// exported to its file here by `cargo xtask art`. The validator holds each to the style
// (docs/art-style.md §7) and to its entry: its class sets its triangle budget, its bounds its
// size and origin (within 1 cm), in metres with +Y up.
[
    // The sandbox's crate: its physics is a 1 m box (creeer_server world/commands.rs); its
    // origin is the centre of its base.
    (name: "crate", file: "models/crate.glb", class: Item, bounds: ((-0.5, 0.0, -0.5), (0.5, 1.0, 0.5))),
    // The engineer (G1.3f): the base body and the starting outfit, skinned on the ragdoll's
    // segments, in three levels of detail (art/engineer.py). Its origin is between its feet on
    // the ground; it faces +z.
    (name: "engineer", file: "models/engineer.glb", class: Character, bounds: ((-0.30, 0.0, -0.17), (0.30, 1.848, 0.20)),
        // Its levels' errors against the close-up one, both ways (G1.3e; a test measures them
        // again): the mid level loses the eyelets, buttons and buckles.
        levels: Some((0.0, 0.0127, 0.0366))),
    // The tools (G1.4c, `art/tools.py`): catalogue tools' sizes; each stands with its handle
    // along +y, its origin where the right hand grips it, its working end facing +z.
    // A felling axe, 81 cm (Gränsfors Bruk's American felling axe; art/axe.py).
    (name: "axe", file: "models/axe.glb", class: Tool, bounds: ((-0.018, -0.06, -0.036), (0.018, 0.742, 0.14))),
    // A pick mattock, 5 lb on a 36 in handle (art/pickaxe.py).
    (name: "pickaxe", file: "models/pickaxe.glb", class: Tool, bounds: ((-0.034, -0.07, -0.236), (0.034, 0.845, 0.25))),
    // A round point shovel with a long handle, 1485 mm (art/shovel.py).
    (name: "shovel", file: "models/shovel.glb", class: Tool, bounds: ((-0.11, -0.10, -0.021), (0.11, 1.385, 0.095))),
    // A 24 in bow saw, 607 mm blade (art/bow_saw.py).
    (name: "bow_saw", file: "models/bow_saw.glb", class: Tool, bounds: ((-0.016, -0.109, -0.02), (0.016, 0.181, 0.618))),
]
