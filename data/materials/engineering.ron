        damping: 0.005,
        conductivity: [("20 °C", "2.9 W/(m·K)"), ("300 °C", "2.2 W/(m·K)"), ("600 °C", "1.9 W/(m·K)")],
        specific_heat: [("20 °C", "790 J/(kg·K)"), ("500 °C", "1000 J/(kg·K)")],
        expansion: "8e-6 K^-1",
        resistivity: "1e9 Ω·m",
        emissivity: 0.9,
        absorptivity: 0.55,
