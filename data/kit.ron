// The creative kit's items (G1.6a, ADR-0028): what a creative server's players may drop, to try
// pockets, containers and carrying with. Survival players find their stones and wood (G1.6c)
// and make their tools (G1.6d). Each: a material (an engineering material's id, or a rock's
// name), a shape (m), and a wall (m) if it is a container. Shapes: Block(size: (x, y, z)),
// Ball(radius), Rod(radius, length), Lump(size: (x, y, z): an ellipsoid of these axes).
// New items go at the end: a kit item is asked for by its place in this list.
[
    // A fist-sized granite cobble: 0.71 kg, too large for any pocket.
    (name: "cobble", material: "granite", form: Ball(radius: 0.04)),
    // A granite pebble, 3 cm: 0.04 kg; twelve fit a chest pocket.
    (name: "pebble", material: "granite", form: Ball(radius: 0.015)),
    // A spruce stick, 45 cm: too long for any pocket.
    (name: "stick", material: "spruce_c24", form: Rod(radius: 0.012, length: 0.45)),
    // A spruce crate of 18 mm boards: 50 × 40 × 40 cm outside, 61 l inside, 7.8 kg.
    (name: "crate", material: "spruce_c24", form: Block(size: (0.5, 0.4, 0.4)), wall: 0.018),
    // G2's demo parts (the first-person builds, 2026-10-30), in green spruce as felled. To add
    // one: a name, a material and a form; the kit lists them in this order.
    // A post, 1.6 m and 100 mm: 10 kg; set 0.6 m in a hole.
    (name: "post", material: "spruce_green", form: Rod(radius: 0.05, length: 1.6)),
    // A rail, 1.6 m and 60 mm: 3.6 kg; a 100 mm nail through it reaches 40 mm into what it
    // crosses (24 mm needed).
    (name: "rail", material: "spruce_green", form: Rod(radius: 0.03, length: 1.6)),
    // A pole, 3 m and 120 mm: 27 kg, about half what two hands lift.
    (name: "pole", material: "spruce_green", form: Rod(radius: 0.06, length: 3.0)),
    // A squared sill, 2.4 m and 150 mm: 43 kg; a log bridge's stringer (it does not roll).
    (name: "sill", material: "spruce_green", form: Block(size: (2.4, 0.15, 0.15))),
    // The bridge site's timber (G2.11, ADR-0039): what a small footbridge over a 2–2.5 m gully
    // is built of, as the BTCV's Footpaths handbook lays one out for a 3 m span (three main
    // beams 150 × 75 mm, decking 150 × 50 × 1125 mm four to the metre, handrail posts 100 × 75 mm,
    // rails 75 × 50 mm), sawn and seasoned (C24). Each is one person's to carry (ADR-0027: 25 kg
    // comfortably). Blocks are (length, height, width) as they lie: a stringer on its edge.
    // A stringer (main beam), 3.0 m × 150 × 75 mm: 14.2 kg.
    (name: "stringer", material: "spruce_c24", form: Block(size: (3.0, 0.15, 0.075))),
    // A deck board, 1125 × 50 × 150 mm, laid across the stringers, 50 mm over each outer one: 3.5 kg.
    (name: "deck board", material: "spruce_c24", form: Block(size: (1.125, 0.05, 0.15))),
    // A sleeper, 1.2 m × 100 × 150 mm: laid across the bank, the stringers' ends on it: 7.6 kg.
    (name: "sleeper", material: "spruce_c24", form: Block(size: (1.2, 0.1, 0.15))),
    // A handrail post, 1.3 m × 100 × 75 mm: nailed to a stringer's side, 1 m standing: 4.1 kg.
    (name: "handrail post", material: "spruce_c24", form: Block(size: (1.3, 0.1, 0.075))),
    // A handrail, 3.0 m × 75 × 50 mm, along the posts' tops: 4.7 kg.
    (name: "handrail", material: "spruce_c24", form: Block(size: (3.0, 0.075, 0.05))),
    // A brace, 1.0 m × 38 × 100 mm: from a post to the stringer, or across under the deck: 1.6 kg.
    (name: "brace", material: "spruce_c24", form: Block(size: (1.0, 0.038, 0.1))),
    // The bridge site's loads: what they weigh is what they are. Each a little over 0.3 m long,
    // so it stays a body where it is put (smaller things at rest are laid as scenery).
    // A block of granite, 320 × 150 × 200 mm: 25.5 kg, one to carry.
    (name: "granite block", material: "granite", form: Block(size: (0.32, 0.15, 0.2))),
    // A sack of gravel, 450 × 100 × 290 mm: 25 kg, as a builder's sack holds (taken as a block).
    (name: "gravel sack", material: "gravel", form: Block(size: (0.45, 0.1, 0.29))),
    // A load crate, 800 × 500 × 500 mm of 22 mm boards: 18 kg empty, carried empty; it holds
    // sixteen granite blocks (157 l), 400 kg, put in one by one where it stands (F).
    (name: "load crate", material: "spruce_c24", form: Block(size: (0.8, 0.5, 0.5)), wall: 0.022),
    // A granite boulder, 500 × 350 × 450 mm: 109 kg, too heavy to lift but within the hands'
    // grab (twice their strength): rolled and dragged across. Lumpy, so it lies where it is put.
    (name: "boulder", material: "granite", form: Lump(size: (0.5, 0.35, 0.45))),
    // A proof load, as bridges are tested: a 1 t block of granite, 1.0 × 0.6 × 0.63 m. No hands
    // move it: it is set from the kit where aimed, as a crane would set it. A footbridge built
    // as the BTCV lays it out carries a crowd (about 3 t at its middle before a beam breaks):
    // carried loads sag it, these break it.
    (name: "test weight", material: "granite", form: Block(size: (1.0, 0.6, 0.63))),
]
